---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Registro | OnlyCartitas"
      description="Crea una cuenta de cliente en OnlyCartitas."
      noindex
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-16 sm:pb-20">
      <section class="mx-auto w-full max-w-2xl px-4 pt-6 sm:px-6 sm:pt-10 lg:px-8">
        <div class="rounded-[2rem] border border-slate-200/80 bg-white/95 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-7">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Cliente</p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[color:var(--color-primary)]">Crear cuenta</h1>
          <p class="mt-3 text-sm leading-7 text-slate-500">Crea tu acceso para asociar pedidos a tu cuenta y recuperar la clave con tu correo registrado.</p>

          <form class="mt-5 grid gap-4 sm:grid-cols-2" data-register-form>
            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Usuario</span>
              <input
                data-register-user
                type="text"
                autocomplete="username"
                class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
              />
              <span class="mt-2 block text-xs text-slate-500">Minimo 3 caracteres.</span>
            </label>

            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Correo</span>
              <input
                data-register-email
                type="email"
                autocomplete="email"
                class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
              />
              <span class="mt-2 block text-xs text-slate-500">Lo usaremos para validar recuperaciones de clave.</span>
            </label>

            <label class="block sm:col-span-2">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Clave</span>
              <input
                data-register-password
                type="password"
                autocomplete="new-password"
                class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
              />
              <span class="mt-2 block text-xs text-slate-500">Debe tener al menos 8 caracteres.</span>
            </label>

            <p class="hidden rounded-[1rem] border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 sm:col-span-2" data-register-error></p>

            <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f] sm:col-span-2">
              Crear cuenta cliente
            </button>
          </form>

          <p class="mt-5 text-center text-sm text-slate-500">
            Ya tienes cuenta?
            <a href="/login" class="font-semibold text-[color:var(--color-primary)] hover:underline">Inicia sesión</a>
          </p>
        </div>
      </section>
    </main>
    <Footer />

    <script>
      type AuthSessionResponse = {
        user: {
          username: string;
          email: string | null;
          role: "admin" | "customer";
        };
        token: string;
        expiresAt: string;
      };

      const SESSION_KEY = "onlycartitas-auth-session";
      const API_BASE_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
      let registerAbortController: AbortController | null = null;

      const isInput = (value: unknown) => value instanceof HTMLInputElement;

      const showError = (message: string) => {
        const errorMessage = document.querySelector("[data-register-error]");
        if (!(errorMessage instanceof HTMLElement)) return;

        errorMessage.textContent = message;
        errorMessage.classList.remove("hidden");
      };

      const createSession = ({ user, token, expiresAt }: AuthSessionResponse) => {
        window.localStorage.setItem(
          SESSION_KEY,
          JSON.stringify({
            user: user.username,
            role: user.role,
            token,
            expiresAt: new Date(expiresAt).getTime()
          })
        );
        window.dispatchEvent(new CustomEvent("onlycartitas:auth-updated"));
      };

      const register = async (username: string, email: string, password: string): Promise<AuthSessionResponse> => {
        const response = await fetch(`${API_BASE_URL}/api/auth/register`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ username, email, password })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          throw new Error(payload?.error ?? "No se pudo crear la cuenta.");
        }

        return payload;
      };

      const initRegisterForm = () => {
        registerAbortController?.abort();
        registerAbortController = new AbortController();
        const signal = registerAbortController.signal;
        const form = document.querySelector("[data-register-form]");
        const userInput = document.querySelector("[data-register-user]");
        const emailInput = document.querySelector("[data-register-email]");
        const passwordInput = document.querySelector("[data-register-password]");

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const username = isInput(userInput) ? userInput.value.trim() : "";
          const email = isInput(emailInput) ? emailInput.value.trim() : "";
          const password = isInput(passwordInput) ? passwordInput.value : "";

          if (username.length < 3) {
            showError("El usuario debe tener al menos 3 caracteres.");
            return;
          }

          if (!email.includes("@")) {
            showError("Ingresa un correo valido para recuperar tu cuenta si lo necesitas.");
            return;
          }

          if (password.length < 8) {
            showError("La clave debe tener al menos 8 caracteres.");
            return;
          }

          try {
            const session = await register(username, email, password);
            createSession(session);
            window.location.assign("/");
          } catch (error) {
            showError(error instanceof Error ? error.message : "No se pudo crear la cuenta.");
          }
        }, { signal });
      };

      document.addEventListener("astro:page-load", initRegisterForm);
      initRegisterForm();
    </script>
  </body>
</html>
