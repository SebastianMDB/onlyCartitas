---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Ayuda | OnlyCartitas" description="Preguntas frecuentes sobre compras, envios, preventas y contacto en OnlyCartitas." />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />
    <main class="pb-20">
      <section class="mx-auto w-full max-w-4xl px-4 pt-8 sm:px-6 lg:px-8">
        <div class="rounded-[2rem] border border-slate-200/80 bg-white/90 p-6 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Ayuda</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[color:var(--color-primary)]">Preguntas frecuentes</h1>
          <div class="mt-8 grid gap-4">
            {[
              ["Como funcionan las preventas?", "Reservas el producto y se coordina entrega cuando llegue el stock del lanzamiento."],
              ["Puedo retirar mi pedido?", "Si. En checkout puedes elegir retiro y coordinar despues de confirmar la compra."],
              ["Que pasa si un producto queda sin stock?", "El producto se oculta de la tienda cuando el inventario llega a cero."],
              ["Los precios estan cerrados?", "El total se confirma en checkout. La pasarela y reglas finales se conectaran al backend despues."]
            ].map(([title, text]) => (
              <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <h2 class="text-lg font-semibold text-slate-950">{title}</h2>
                <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
              </article>
            ))}
          </div>
        </div>

        <div id="contacto" class="mt-6 rounded-[2rem] border border-slate-200/80 bg-white/90 p-6 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Contacto</p>
          <h2 class="mt-2 text-2xl font-semibold text-[color:var(--color-primary)]">Canales de atencion</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">Agrega aqui WhatsApp, Instagram y correo cuando tengas definidos los canales oficiales.</p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
