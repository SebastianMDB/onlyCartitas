---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Pagina no encontrada | OnlyCartitas"
      description="La pagina que buscas no existe o cambio de lugar. Vuelve al catalogo de OnlyCartitas para seguir explorando cartas Pokemon TCG."
      noindex
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-20">
      <section class="mx-auto grid min-h-[calc(100dvh-12rem)] w-full max-w-7xl items-center gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,460px)] lg:px-8">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Error 404</p>
          <h1 class="mt-3 text-4xl font-semibold leading-tight tracking-tight text-[color:var(--color-primary)] sm:text-6xl">
            Esta carta se perdio en la ruta.
          </h1>
          <p class="mt-5 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
            Cubone la esta cuidando mientras vuelve al mazo. Puedes regresar al catalogo y seguir buscando productos disponibles.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/productos" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#071c2b] px-6 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f]">
              Ver catalogo
            </a>
            <a href="/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950">
              Volver al inicio
            </a>
          </div>
        </div>

        <div class="relative mx-auto aspect-square w-full max-w-[460px]" aria-hidden="true">
          <div class="absolute inset-x-10 bottom-8 h-10 rounded-full bg-slate-300/45 blur-xl"></div>
          <svg viewBox="0 0 420 420" class="relative h-full w-full drop-shadow-[0_28px_50px_rgba(17,48,71,0.18)]" role="img">
            <defs>
              <linearGradient id="boneFill" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="#fff7d6" />
                <stop offset="1" stop-color="#d9c783" />
              </linearGradient>
              <linearGradient id="bodyFill" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0" stop-color="#d99c66" />
                <stop offset="1" stop-color="#9f623d" />
              </linearGradient>
            </defs>
            <circle cx="210" cy="218" r="152" fill="#dcecf7" />
            <circle cx="132" cy="132" r="20" fill="#ffd23f" />
            <circle cx="304" cy="112" r="10" fill="#739ab9" />
            <path d="M113 305c34 40 149 51 202 0 12 34-5 64-57 74-61 12-136-10-145-74Z" fill="#113047" opacity=".12" />

            <path d="M170 228c-25 22-40 57-36 92 5 43 38 70 80 70 41 0 72-27 77-70 4-36-10-70-35-92-24 15-61 15-86 0Z" fill="url(#bodyFill)" />
            <path d="M159 326c14 13 26 19 53 19 28 0 42-7 57-21-6 37-31 55-58 55-30 0-50-18-52-53Z" fill="#7d4a31" opacity=".38" />
            <path d="M151 260c-26 7-44 29-50 54 17 1 35-4 50-17 10-9 14-23 10-34-2-4-5-5-10-3Z" fill="#9f623d" />
            <path d="M267 260c27 7 45 29 51 54-18 1-35-4-51-17-10-9-14-23-10-34 2-4 6-5 10-3Z" fill="#9f623d" />

            <path d="M104 139c-18-12-23-33-11-48 13-16 35-13 48 5 11-23 38-33 61-21 13 7 21 18 25 31 14-23 45-29 66-12 16 13 19 36 6 54 25 9 37 34 28 57-8 22-31 33-56 27-11 29-35 51-62 51-29 0-54-21-65-51-28 7-54-6-61-30-7-23 2-48 21-63Z" fill="url(#boneFill)" />
            <path d="M117 149c-10-8-12-21-4-29 9-10 23-7 32 6 5-28 41-40 62-22 10 8 14 20 12 35 15-28 49-33 66-10 9 12 7 27-4 38 21 6 31 22 25 38-7 18-27 24-49 14-5 28-25 48-49 48s-44-20-49-48c-23 11-45 3-52-16-7-18-2-39 10-54Z" fill="#f6e8ad" />
            <path d="M161 173c0-21 17-38 48-38 32 0 49 17 49 38 0 28-23 48-49 48-25 0-48-20-48-48Z" fill="#1d2730" />
            <path d="M179 176c0-7 5-12 12-12s12 5 12 12-5 12-12 12-12-5-12-12Z" fill="#f4f9fc" />
            <path d="M217 176c0-7 5-12 12-12s12 5 12 12-5 12-12 12-12-5-12-12Z" fill="#f4f9fc" />
            <path d="M204 197c4 5 9 5 13 0" fill="none" stroke="#f4f9fc" stroke-linecap="round" stroke-width="5" />

            <path d="M95 246c-20-17-37-18-52-6 3 18 17 28 43 29 5-6 8-13 9-23Z" fill="url(#boneFill)" />
            <path d="M325 246c20-17 37-18 52-6-3 18-17 28-43 29-5-6-8-13-9-23Z" fill="url(#boneFill)" />
            <path d="M197 289c8 8 19 8 28 0" fill="none" stroke="#7d4a31" stroke-linecap="round" stroke-width="7" />
          </svg>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
