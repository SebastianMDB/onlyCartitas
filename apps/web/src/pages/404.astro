---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Página no encontrada | OnlyCartitas"
      description="La página que buscas no existe o cambió de lugar. Vuelve al catálogo de OnlyCartitas para seguir explorando cartas Pokémon TCG."
      noindex
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-20">
      <section class="mx-auto grid min-h-[calc(100dvh-12rem)] w-full max-w-7xl items-center gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,460px)] lg:px-8">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Error 404</p>
          <h1 class="mt-3 text-4xl font-semibold leading-tight tracking-tight text-[color:var(--color-primary)] sm:text-6xl">
            Esta carta se perdió en la ruta.
          </h1>
          <p class="mt-5 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
            Cubone la está cuidando mientras vuelve al mazo. Puedes regresar al catálogo y seguir buscando productos disponibles.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/productos" class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#071c2b] px-6 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f]">
              Ver catálogo
            </a>
            <a href="/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950">
              Volver al inicio
            </a>
          </div>
        </div>

        <div class="relative mx-auto aspect-square w-full max-w-[460px]" aria-hidden="true">
          <div class="absolute inset-x-10 bottom-8 h-10 rounded-full bg-slate-300/45 blur-xl"></div>
          <div class="absolute inset-0 rounded-[2rem] border border-white/65 bg-[#dcecf7] shadow-[0_28px_50px_rgba(17,48,71,0.18)]"></div>
          <div class="absolute inset-4 rounded-[1.5rem] border border-slate-950/10 bg-white/55"></div>
          <div class="relative flex h-full w-full items-center justify-center overflow-hidden rounded-[2rem] p-4">
            <div class="absolute inset-6 rounded-[1.25rem] bg-white"></div>
            <img
              src="/sets/cubone.jpg"
              alt=""
              width="1200"
              height="675"
              class="relative h-[132%] w-[132%] max-w-none object-cover object-center [image-rendering:pixelated]"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
