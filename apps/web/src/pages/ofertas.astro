---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import { fetchProducts, productLanguages } from "../lib/catalog";
import "../styles/global.css";

const offerProducts = await fetchProducts({ offer: true });
const offerCategories = Array.from(new Set(offerProducts.map((product) => product.category))).sort();
const offerSets = Array.from(new Set(offerProducts.map((product) => product.set))).sort();
const maxDiscount = offerProducts.reduce((currentMax, product) => {
  if (!product.previousPrice || product.previousPrice <= product.price) return currentMax;
  const discount = Math.round(((product.previousPrice - product.price) / product.previousPrice) * 100);
  return Math.max(currentMax, discount);
}, 0);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Ofertas | OnlyCartitas"
      description="Ofertas de OnlyCartitas en productos sellados y singles con precio rebajado, filtros por categoria, set e idioma."
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-20">
      <section class="mx-auto w-full max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
        <div class="overflow-hidden rounded-[2rem] bg-[linear-gradient(135deg,#113047_0%,#173b56_100%)] px-6 py-8 text-white shadow-[0_28px_80px_rgba(17,48,71,0.24)] sm:px-8 lg:px-10">
          <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
            <div class="max-w-2xl">
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-amber-200">Ofertas</p>
              <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Precios destacados</h1>
              <p class="mt-4 max-w-xl text-sm leading-7 text-slate-200 sm:text-base">
                Sellados y singles rebajados reunidos en un solo lugar.
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-[1.4rem] border border-white/10 bg-white/6 px-4 py-4 backdrop-blur-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">Productos</p>
                <p class="mt-2 text-2xl font-semibold text-white">{offerProducts.length}</p>
              </div>
              <div class="rounded-[1.4rem] border border-white/10 bg-white/6 px-4 py-4 backdrop-blur-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">Categorias</p>
                <p class="mt-2 text-2xl font-semibold text-white">{offerCategories.length}</p>
              </div>
              <div class="rounded-[1.4rem] border border-white/10 bg-white/6 px-4 py-4 backdrop-blur-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">Hasta</p>
                <p class="mt-2 text-2xl font-semibold text-white">{maxDiscount}%</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto mt-10 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 rounded-[2rem] border border-slate-200/80 bg-white/90 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-6">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">
                Filtrar
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[color:var(--color-primary)]">
                Todas las ofertas
              </h2>
            </div>

            <div class="flex flex-wrap gap-2">
              <button type="button" class="rounded-full bg-[color:var(--color-primary)] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#173b56]" data-category-button data-category="all" aria-pressed="true">Todas</button>
              {offerCategories.map((category) => <button type="button" class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" data-category-button data-category={category.toLowerCase()} aria-pressed="false">{category}</button>)}
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Set</span>
              <select data-set-filter class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                <option value="all">Todos los sets</option>
                {offerSets.map((setName) => <option value={setName.toLowerCase()}>{setName}</option>)}
              </select>
            </label>

            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Idioma</span>
              <select data-language-filter class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                <option value="all">Todos los idiomas</option>
                {productLanguages.map((language) => <option value={language.value}>{language.label}</option>)}
              </select>
            </label>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-slate-500">Mostrando <span class="font-semibold text-slate-900" data-results-count>{offerProducts.length}</span> ofertas</p>
            <p class="text-sm text-slate-500">Usa el buscador superior o filtra por categoria, set e idioma.</p>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
            {offerProducts.map((product) => <ProductCard product={product} layout="grid" />)}
          </div>

          <div class="hidden rounded-[1.5rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center" data-empty-state>
            <p class="text-lg font-semibold text-[color:var(--color-primary)]">No hay resultados</p>
            <p class="mt-2 text-sm text-slate-500">Prueba con otro nombre o cambia el filtro.</p>
          </div>
        </div>
      </section>
    </main>
    <Footer />

    <script>
      const isHTMLElement = (value) => value instanceof HTMLElement;
      const isButtonElement = (value) => value instanceof HTMLButtonElement;
      const productCards = Array.from(document.querySelectorAll("[data-product-card]"));
      const categoryButtons = Array.from(document.querySelectorAll("[data-category-button]"));
      const setFilter = document.querySelector("[data-set-filter]");
      const languageFilter = document.querySelector("[data-language-filter]");
      const resultsCount = document.querySelector("[data-results-count]");
      const emptyState = document.querySelector("[data-empty-state]");
      let activeCategory = "all";
      let activeSet = "all";
      let activeLanguage = "all";
      let activeQuery = "";

      const updateCategoryButtons = () => {
        categoryButtons.forEach((button) => {
          if (!isButtonElement(button)) return;
          const isActive = button.dataset.category === activeCategory;
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
          button.className = isActive
            ? "rounded-full bg-[color:var(--color-primary)] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#173b56]"
            : "rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900";
        });
      };

      const updateProducts = () => {
        let visibleCount = 0;
        productCards.forEach((card) => {
          if (!isHTMLElement(card)) return;
          const productName = card.dataset.productName ?? "";
          const productCategory = card.dataset.productCategory ?? "";
          const productSet = card.dataset.productSet ?? "";
          const productIllustrator = card.dataset.productIllustrator ?? "";
          const productLanguage = card.dataset.productLanguage ?? "";
          const productLanguageLabel = card.dataset.productLanguageLabel ?? "";
          const matchesQuery =
            activeQuery.length === 0 ||
            productName.includes(activeQuery) ||
            productCategory.includes(activeQuery) ||
            productSet.includes(activeQuery) ||
            productIllustrator.includes(activeQuery) ||
            productLanguage.includes(activeQuery) ||
            productLanguageLabel.includes(activeQuery);
          const matchesCategory = activeCategory === "all" || productCategory === activeCategory;
          const matchesSet = activeSet === "all" || productSet === activeSet;
          const matchesLanguage = activeLanguage === "all" || productLanguage === activeLanguage;
          const isVisible = matchesQuery && matchesCategory && matchesSet && matchesLanguage;
          card.style.display = isVisible ? "" : "none";
          if (isVisible) visibleCount += 1;
        });
        if (isHTMLElement(resultsCount)) resultsCount.textContent = String(visibleCount);
        if (isHTMLElement(emptyState)) emptyState.style.display = visibleCount === 0 ? "block" : "none";
      };

      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (!isButtonElement(button)) return;
          activeCategory = button.dataset.category ?? "all";
          updateCategoryButtons();
          updateProducts();
        });
      });

      if (setFilter instanceof HTMLSelectElement) {
        setFilter.addEventListener("change", () => {
          activeSet = setFilter.value;
          updateProducts();
        });
      }

      if (languageFilter instanceof HTMLSelectElement) {
        languageFilter.addEventListener("change", () => {
          activeLanguage = languageFilter.value;
          updateProducts();
        });
      }

      window.addEventListener("carta-noble:search", (event) => {
        activeQuery = event instanceof CustomEvent && typeof event.detail === "string" ? event.detail.trim().toLowerCase() : "";
        updateProducts();
      });

      updateCategoryButtons();
      updateProducts();
    </script>
  </body>
</html>
