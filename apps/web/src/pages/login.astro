---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Iniciar sesion | OnlyCartitas"
      description="Acceso para clientes y administradores de OnlyCartitas."
      noindex
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-14 sm:pb-18">
      <section class="mx-auto grid w-full max-w-5xl gap-5 px-4 pt-6 sm:px-6 sm:pt-10 lg:grid-cols-[0.86fr_1fr] lg:items-start lg:px-8">
        <div class="overflow-hidden rounded-[1.75rem] border border-slate-200/80 bg-white/90 shadow-[0_20px_60px_rgba(17,48,71,0.08)]">
          <div class="bg-[color:var(--color-primary)] px-5 py-5 text-white sm:px-7 sm:py-6">
            <div class="flex items-center gap-4">
              <img
                src="/sets/logo.webp"
                alt="OnlyCartitas"
                width="72"
                height="72"
                class="h-14 w-14 shrink-0 rounded-2xl object-cover shadow-[0_16px_36px_rgba(0,0,0,0.18)]"
                loading="eager"
                decoding="async"
              />
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-200">Cuenta OnlyCartitas</p>
                <h1 class="mt-1 text-3xl font-semibold tracking-normal text-white sm:text-4xl">Iniciar sesion</h1>
              </div>
            </div>

            <p class="mt-5 max-w-xl text-sm leading-7 text-slate-100">
              Revisa tus pedidos, mantiene tus datos actualizados y continua compras con tu carrito desde cualquier dispositivo.
            </p>
          </div>

          <div class="grid gap-0 divide-y divide-slate-200/80 text-sm text-slate-600 sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:grid-cols-1 lg:divide-x-0 lg:divide-y">
            <div class="p-4">
              <p class="font-semibold text-slate-950">Usuario</p>
              <p class="mt-1 leading-6">Entra con tu nombre de usuario, no con el correo.</p>
            </div>
            <div class="p-4">
              <p class="font-semibold text-slate-950">Compras</p>
              <p class="mt-1 leading-6">Tus pedidos quedan asociados a la cuenta.</p>
            </div>
            <div class="p-4">
              <p class="font-semibold text-slate-950">Clave</p>
              <p class="mt-1 leading-6">El link de recuperacion se usa una sola vez.</p>
            </div>
          </div>
        </div>

        <div class="grid gap-4">
          <section class="rounded-[1.75rem] border border-slate-200/80 bg-white/95 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-7" aria-labelledby="login-title">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-secondary)]">Acceso</p>
                <h2 id="login-title" class="mt-1 text-2xl font-semibold tracking-normal text-[color:var(--color-primary)] sm:text-3xl">Tus datos</h2>
              </div>
              <a href="/registro" class="inline-flex min-h-10 items-center justify-center rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950">
                Crear cuenta
              </a>
            </div>

            <form class="mt-6 grid gap-4" data-login-form>
              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Usuario</span>
                <input
                  data-login-user
                  type="text"
                  autocomplete="username"
                  placeholder="tu_usuario"
                  class="h-13 w-full rounded-[1rem] border border-slate-300 bg-white px-4 text-base text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
                />
              </label>

              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Clave</span>
                <input
                  data-login-password
                  type="password"
                  autocomplete="current-password"
                  placeholder="Minimo 8 caracteres"
                  class="h-13 w-full rounded-[1rem] border border-slate-300 bg-white px-4 text-base text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
                />
              </label>

              <p class="hidden rounded-[1rem] border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" data-login-error>
                No pudimos iniciar sesion. Revisa usuario y clave.
              </p>

              <button data-login-submit type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f] disabled:cursor-not-allowed disabled:opacity-60">
                Entrar
              </button>
            </form>
          </section>

          <section class="rounded-[1.5rem] border border-slate-200/80 bg-white/90 p-5 shadow-[0_14px_42px_rgba(17,48,71,0.06)] sm:p-6" data-reset-panel aria-labelledby="reset-title">
            <div class="flex flex-col gap-1 border-b border-slate-200/80 pb-4">
              <h2 id="reset-title" class="text-lg font-semibold tracking-normal text-[color:var(--color-primary)]">Recuperar clave</h2>
              <p class="text-sm leading-6 text-slate-500">Confirma el usuario y correo registrado. Te enviaremos un link temporal.</p>
            </div>

            <form class="mt-4 grid gap-4 sm:grid-cols-2" data-reset-request-form>
              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Usuario</span>
                <input data-reset-user type="text" autocomplete="username" placeholder="tu_usuario" class="h-12 w-full rounded-[1rem] border border-slate-300 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
              </label>
              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Correo registrado</span>
                <input data-reset-email type="email" autocomplete="email" placeholder="correo@dominio.cl" class="h-12 w-full rounded-[1rem] border border-slate-300 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
              </label>
              <p class="hidden rounded-[1rem] px-4 py-3 text-sm font-semibold sm:col-span-2" data-reset-message></p>
              <button data-reset-request-submit type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-400 hover:text-slate-950 sm:col-span-2 disabled:cursor-not-allowed disabled:opacity-60">
                Enviar link
              </button>
            </form>

            <form class="mt-4 hidden gap-4" data-reset-confirm-form>
              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Nueva clave</span>
                <input data-reset-password type="password" autocomplete="new-password" placeholder="Minimo 8 caracteres" class="h-12 w-full rounded-[1rem] border border-slate-300 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                <span class="mt-2 block text-xs text-slate-500">El link expira pronto y se puede usar una sola vez.</span>
              </label>
              <p class="hidden rounded-[1rem] px-4 py-3 text-sm font-semibold" data-reset-confirm-message></p>
              <button data-reset-confirm-submit type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950 disabled:cursor-not-allowed disabled:opacity-60">
                Guardar nueva clave
              </button>
            </form>
          </section>
        </div>
      </section>
    </main>
    <Footer />

    <style>
      html[data-theme="dark"] [data-reset-panel] {
        background: linear-gradient(145deg, rgba(14, 45, 61, 0.92), rgba(6, 22, 33, 0.96)) !important;
        border-color: rgba(127, 199, 216, 0.24) !important;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.28) !important;
      }

      html[data-theme="dark"] [data-reset-panel] > div {
        border-color: rgba(127, 199, 216, 0.22) !important;
      }
    </style>

    <script>
      type AuthSessionResponse = {
        user: {
          username: string;
          email: string | null;
          role: "admin" | "customer";
        };
        token: string;
        expiresAt: string;
      };

      const SESSION_KEY = "onlycartitas-auth-session";
      const API_BASE_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
      let loginAbortController: AbortController | null = null;

      const isInput = (value: unknown) => value instanceof HTMLInputElement;

      const showResetMessage = (message: string, type: "error" | "success", selector = "[data-reset-message]") => {
        const resetMessage = document.querySelector(selector);
        if (!(resetMessage instanceof HTMLElement)) return;

        resetMessage.textContent = message;
        resetMessage.classList.remove("hidden", "border", "border-red-200", "bg-red-50", "text-red-700", "border-emerald-200", "bg-emerald-50", "text-emerald-700");
        resetMessage.classList.add(
          "border",
          type === "success" ? "border-emerald-200" : "border-red-200",
          type === "success" ? "bg-emerald-50" : "bg-red-50",
          type === "success" ? "text-emerald-700" : "text-red-700"
        );
      };

      const createSession = ({ user, token, expiresAt }: AuthSessionResponse) => {
        window.localStorage.setItem(
          SESSION_KEY,
          JSON.stringify({
            user: user.username,
            role: user.role,
            token,
            expiresAt: new Date(expiresAt).getTime()
          })
        );
        window.dispatchEvent(new CustomEvent("onlycartitas:auth-updated"));
      };

      const login = async (username: string, password: string): Promise<AuthSessionResponse> => {
        const response = await fetch(`${API_BASE_URL}/api/auth/login`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ username, password })
        });

        if (!response.ok) {
          throw new Error("Credenciales invalidas");
        }

        return response.json();
      };

      const requestPasswordReset = async (username: string, email: string) => {
        const response = await fetch(`${API_BASE_URL}/api/auth/reset-password/request`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ username, email })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error ?? "No se pudo enviar el link de recuperacion.");
        return payload?.message ?? "Si los datos coinciden, enviaremos un link de recuperacion al correo registrado.";
      };

      const confirmPasswordReset = async (token: string, password: string) => {
        const response = await fetch(`${API_BASE_URL}/api/auth/reset-password/confirm`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ token, password })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error ?? "No se pudo guardar la nueva clave.");
      };

      const initLoginForm = () => {
        loginAbortController?.abort();
        loginAbortController = new AbortController();
        const signal = loginAbortController.signal;
        const form = document.querySelector("[data-login-form]");
        const userInput = document.querySelector("[data-login-user]");
        const passwordInput = document.querySelector("[data-login-password]");
        const loginSubmit = document.querySelector("[data-login-submit]");
        const errorMessage = document.querySelector("[data-login-error]");
        const resetRequestForm = document.querySelector("[data-reset-request-form]");
        const resetConfirmForm = document.querySelector("[data-reset-confirm-form]");
        const resetUserInput = document.querySelector("[data-reset-user]");
        const resetEmailInput = document.querySelector("[data-reset-email]");
        const resetPasswordInput = document.querySelector("[data-reset-password]");
        const resetRequestSubmit = document.querySelector("[data-reset-request-submit]");
        const resetConfirmSubmit = document.querySelector("[data-reset-confirm-submit]");
        const resetToken = new URLSearchParams(window.location.search).get("resetToken")?.trim() ?? "";

        if (resetToken && resetConfirmForm instanceof HTMLElement && resetRequestForm instanceof HTMLElement) {
          resetRequestForm.classList.add("hidden");
          resetConfirmForm.classList.remove("hidden");
          resetConfirmForm.classList.add("grid");
        }

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const username = isInput(userInput) ? userInput.value.trim() : "";
          const password = isInput(passwordInput) ? passwordInput.value : "";

          if (username.length < 3) {
            if (errorMessage instanceof HTMLElement) errorMessage.textContent = "Ingresa tu usuario para iniciar sesion.";
            errorMessage?.classList.remove("hidden");
            return;
          }

          if (password.length < 8) {
            if (errorMessage instanceof HTMLElement) errorMessage.textContent = "La clave debe tener al menos 8 caracteres.";
            errorMessage?.classList.remove("hidden");
            return;
          }

          try {
            if (loginSubmit instanceof HTMLButtonElement) {
              loginSubmit.disabled = true;
              loginSubmit.textContent = "Entrando...";
            }
            const session = await login(username, password);
            createSession(session);
            errorMessage?.classList.add("hidden");
            window.location.assign(session.user.role === "admin" ? "/admin-inventario" : "/");
          } catch {
            if (errorMessage instanceof HTMLElement) errorMessage.textContent = "No pudimos iniciar sesion. Revisa usuario y clave.";
            errorMessage?.classList.remove("hidden");
            if (loginSubmit instanceof HTMLButtonElement) {
              loginSubmit.disabled = false;
              loginSubmit.textContent = "Entrar";
            }
          }
        }, { signal });

        resetRequestForm?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const username = isInput(resetUserInput) ? resetUserInput.value.trim() : "";
          const email = isInput(resetEmailInput) ? resetEmailInput.value.trim() : "";

          if (username.length < 3) {
            showResetMessage("Ingresa un usuario valido para pedir el link.", "error");
            return;
          }

          if (!email.includes("@")) {
            showResetMessage("Ingresa el correo asociado a esa cuenta.", "error");
            return;
          }

          try {
            if (resetRequestSubmit instanceof HTMLButtonElement) {
              resetRequestSubmit.disabled = true;
              resetRequestSubmit.textContent = "Enviando...";
            }
            showResetMessage("Enviando link de recuperacion...", "success");
            const message = await requestPasswordReset(username, email);
            showResetMessage(message, "success");
          } catch (error) {
            showResetMessage(error instanceof Error ? error.message : "No se pudo enviar el link de recuperacion.", "error");
          } finally {
            if (resetRequestSubmit instanceof HTMLButtonElement) {
              resetRequestSubmit.disabled = false;
              resetRequestSubmit.textContent = "Enviar link";
            }
          }
        }, { signal });

        resetConfirmForm?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const password = isInput(resetPasswordInput) ? resetPasswordInput.value : "";

          if (!resetToken) {
            showResetMessage("El link de recuperacion no es valido.", "error", "[data-reset-confirm-message]");
            return;
          }

          if (password.length < 8) {
            showResetMessage("La nueva clave debe tener al menos 8 caracteres.", "error", "[data-reset-confirm-message]");
            return;
          }

          try {
            if (resetConfirmSubmit instanceof HTMLButtonElement) resetConfirmSubmit.disabled = true;
            await confirmPasswordReset(resetToken, password);
            if (isInput(resetPasswordInput)) resetPasswordInput.value = "";
            window.history.replaceState({}, "", "/login");
            showResetMessage("Clave actualizada. Ya puedes iniciar sesion con tu nueva clave.", "success", "[data-reset-confirm-message]");
          } catch (error) {
            showResetMessage(error instanceof Error ? error.message : "No se pudo guardar la nueva clave.", "error", "[data-reset-confirm-message]");
          } finally {
            if (resetConfirmSubmit instanceof HTMLButtonElement) resetConfirmSubmit.disabled = false;
          }
        }, { signal });
      };

      document.addEventListener("astro:page-load", initLoginForm);
      initLoginForm();
    </script>
  </body>
</html>
