---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Iniciar sesion | OnlyCartitas"
      description="Acceso para clientes y administradores de OnlyCartitas."
      noindex
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="grid place-items-center px-4 py-10 sm:px-6 sm:py-14">
      <section class="w-full max-w-md" aria-labelledby="login-title">
        <div class="rounded-[1.5rem] border border-slate-200/80 bg-white/95 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-7">
          <div class="text-center">
            <img
              src="/sets/logo.webp"
              alt="OnlyCartitas"
              width="72"
              height="72"
              class="mx-auto h-16 w-16 rounded-2xl object-cover shadow-[0_16px_36px_rgba(0,0,0,0.16)]"
              loading="eager"
              decoding="async"
            />
            <p class="mt-5 text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-secondary)]">Cuenta OnlyCartitas</p>
            <h1 id="login-title" class="mt-1 text-3xl font-semibold tracking-normal text-[color:var(--color-primary)]">Iniciar sesion</h1>
          </div>

          <form class="mt-6 grid gap-4" data-login-form>
            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Usuario</span>
              <input
                data-login-user
                type="text"
                autocomplete="username"
                placeholder="tu_usuario"
                class="h-13 w-full rounded-[1rem] border border-slate-300 bg-white px-4 text-base text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
              />
            </label>

            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Clave</span>
              <input
                data-login-password
                type="password"
                autocomplete="current-password"
                placeholder="Minimo 8 caracteres"
                class="h-13 w-full rounded-[1rem] border border-slate-300 bg-white px-4 text-base text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
              />
            </label>

            <div class="flex justify-end">
              <a href="/recuperar-clave" class="text-sm font-semibold text-[color:var(--color-primary)] hover:underline">Olvidaste tu clave?</a>
            </div>

            <p class="hidden rounded-[1rem] border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" data-login-error>
              No pudimos iniciar sesion. Revisa usuario y clave.
            </p>

            <button data-login-submit type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f] disabled:cursor-not-allowed disabled:opacity-60">
              Entrar
            </button>
          </form>

          <p class="mt-6 border-t border-slate-200/80 pt-5 text-center text-sm text-slate-500">
            No tienes cuenta?
            <a href="/registro" class="font-semibold text-[color:var(--color-primary)] hover:underline">Crea una</a>
          </p>
        </div>
      </section>
    </main>
    <Footer />

    <script>
      type AuthSessionResponse = {
        user: {
          username: string;
          email: string | null;
          role: "admin" | "customer";
        };
        token: string;
        expiresAt: string;
      };

      const SESSION_KEY = "onlycartitas-auth-session";
      const API_BASE_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
      let loginAbortController: AbortController | null = null;

      const isInput = (value: unknown) => value instanceof HTMLInputElement;

      const createSession = ({ user, token, expiresAt }: AuthSessionResponse) => {
        window.localStorage.setItem(
          SESSION_KEY,
          JSON.stringify({
            user: user.username,
            role: user.role,
            token,
            expiresAt: new Date(expiresAt).getTime()
          })
        );
        window.dispatchEvent(new CustomEvent("onlycartitas:auth-updated"));
      };

      const login = async (username: string, password: string): Promise<AuthSessionResponse> => {
        const response = await fetch(`${API_BASE_URL}/api/auth/login`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ username, password })
        });

        if (!response.ok) {
          throw new Error("Credenciales invalidas");
        }

        return response.json();
      };

      const initLoginForm = () => {
        loginAbortController?.abort();
        loginAbortController = new AbortController();
        const signal = loginAbortController.signal;
        const form = document.querySelector("[data-login-form]");
        const userInput = document.querySelector("[data-login-user]");
        const passwordInput = document.querySelector("[data-login-password]");
        const loginSubmit = document.querySelector("[data-login-submit]");
        const errorMessage = document.querySelector("[data-login-error]");

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const username = isInput(userInput) ? userInput.value.trim() : "";
          const password = isInput(passwordInput) ? passwordInput.value : "";

          if (username.length < 3) {
            if (errorMessage instanceof HTMLElement) errorMessage.textContent = "Ingresa tu usuario para iniciar sesion.";
            errorMessage?.classList.remove("hidden");
            return;
          }

          if (password.length < 8) {
            if (errorMessage instanceof HTMLElement) errorMessage.textContent = "La clave debe tener al menos 8 caracteres.";
            errorMessage?.classList.remove("hidden");
            return;
          }

          try {
            if (loginSubmit instanceof HTMLButtonElement) {
              loginSubmit.disabled = true;
              loginSubmit.textContent = "Entrando...";
            }
            const session = await login(username, password);
            createSession(session);
            errorMessage?.classList.add("hidden");
            window.location.assign(session.user.role === "admin" ? "/admin-inventario" : "/");
          } catch {
            if (errorMessage instanceof HTMLElement) errorMessage.textContent = "No pudimos iniciar sesion. Revisa usuario y clave.";
            errorMessage?.classList.remove("hidden");
            if (loginSubmit instanceof HTMLButtonElement) {
              loginSubmit.disabled = false;
              loginSubmit.textContent = "Entrar";
            }
          }
        }, { signal });
      };

      document.addEventListener("astro:page-load", initLoginForm);
      initLoginForm();
    </script>
  </body>
</html>
