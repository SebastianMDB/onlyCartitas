---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { productLanguages } from "../lib/catalog";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
const products = [];
const productSections = [];
const sealedSets = [];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Productos sellados Pokemon TCG | OnlyCartitas"
      description="Compra productos sellados Pokemon TCG en Chile: Elite Trainer Box, sobres, cajas, bundles, colecciones y accesorios en OnlyCartitas."
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-20">
      <section class="mx-auto w-full max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
        <div class="overflow-hidden rounded-[2rem] bg-[color:var(--color-primary)] px-6 py-8 text-white shadow-[0_28px_80px_rgba(17,48,71,0.22)] sm:px-8 lg:px-10">
          <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
            <div class="max-w-2xl">
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-300">Sellados</p>
              <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Productos sellados</h1>
              <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
                ETB, sobres, cajas y bundles listos para abrir o coleccionar.
              </p>
            </div>

            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-[1.4rem] border border-white/10 bg-white/6 px-4 py-4 backdrop-blur-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">Categorias</p>
                <p class="mt-2 text-2xl font-semibold text-white" data-stat="categories">{productSections.length}</p>
              </div>
              <div class="rounded-[1.4rem] border border-white/10 bg-white/6 px-4 py-4 backdrop-blur-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">Productos</p>
                <p class="mt-2 text-2xl font-semibold text-white" data-stat="products">{products.length}</p>
              </div>
              <div class="rounded-[1.4rem] border border-white/10 bg-white/6 px-4 py-4 backdrop-blur-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">Ofertas</p>
                <p class="mt-2 text-2xl font-semibold text-white" data-stat="offers">0</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto mt-10 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 rounded-[2rem] border border-slate-200/80 bg-white/90 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-6">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">
                Filtrar
              </p>
              <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[color:var(--color-primary)]">
                Encuentra tu sellado
              </h2>
            </div>

            <div class="flex flex-wrap gap-2" data-category-filters>
              <button type="button" class="rounded-full bg-[color:var(--color-primary)] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#173b56]" data-category-button data-category="all" aria-pressed="true">Todos</button>
              {productSections.map((section) => <button type="button" class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" data-category-button data-category={section.toLowerCase()} aria-pressed="false">{section}</button>)}
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Set</span>
              <select data-set-filter class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                <option value="all">Todos los sets</option>
                {sealedSets.map((setName) => <option value={setName.toLowerCase()}>{setName}</option>)}
              </select>
            </label>

            <label class="block">
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Idioma</span>
              <select data-language-filter class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                <option value="all">Todos los idiomas</option>
                {productLanguages.map((language) => <option value={language.value}>{language.label}</option>)}
              </select>
            </label>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-slate-500">Mostrando <span class="font-semibold text-slate-900" data-results-count>{products.length}</span> productos</p>
            <p class="text-sm text-slate-500">Usa el buscador superior o filtra por categoria, set e idioma.</p>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3" data-products-grid>
          </div>

          <div class="hidden rounded-[1.5rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center" data-empty-state>
            <p class="text-lg font-semibold text-[color:var(--color-primary)]">No hay resultados</p>
            <p class="mt-2 text-sm text-slate-500">Prueba con otro nombre o cambia la categoria.</p>
          </div>
        </div>
      </section>
    </main>
    <Footer />

    <script is:inline type="application/json" data-catalog-config set:html={JSON.stringify({ apiBaseUrl, kind: "sealed", layout: "sealed", columns: "three" })}></script>
    <script>
      import "../scripts/catalog-runtime";
    </script>
  </body>
</html>
