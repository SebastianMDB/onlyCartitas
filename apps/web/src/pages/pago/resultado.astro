---
import Header from "../../components/Header.astro";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Resultado de pago | OnlyCartitas"
      description="Resultado de pago de tu pedido en OnlyCartitas."
      noindex
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="mx-auto w-full max-w-2xl px-4 py-16 sm:px-6 lg:px-8">
      <section class="rounded-[2rem] border border-slate-200/80 bg-white/90 p-6 text-center shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Mercado Pago</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-[color:var(--color-primary)]" data-payment-title>
          Revisando pago
        </h1>
        <p class="mt-3 text-sm leading-6 text-slate-600" data-payment-copy>
          Estamos procesando el resultado informado por Mercado Pago.
        </p>
        <p class="mt-4 hidden rounded-2xl bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-600" data-payment-order></p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/cuenta" class="inline-flex min-h-11 items-center justify-center rounded-full bg-[#071c2b] px-6 py-3 text-sm font-semibold text-white">Ver mi cuenta</a>
          <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700">Volver al inicio</a>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const CART_STORAGE_PREFIX = "carta-noble-cart";
      const SESSION_STORAGE_KEY = "onlycartitas-auth-session";
      const API_BASE_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
      const params = new URLSearchParams(window.location.search);
      const status = params.get("status") ?? params.get("collection_status") ?? "pending";
      const orderId = params.get("order_id") ?? params.get("external_reference");
      const paymentId = params.get("payment_id") ?? params.get("collection_id");
      const title = document.querySelector("[data-payment-title]");
      const copy = document.querySelector("[data-payment-copy]");
      const order = document.querySelector("[data-payment-order]");

      const readSession = () => {
        try {
          const storedSession = window.localStorage.getItem(SESSION_STORAGE_KEY);
          const session = storedSession ? JSON.parse(storedSession) : null;
          if (!session?.expiresAt || Date.now() > Number(session.expiresAt)) return null;
          return session;
        } catch {
          return null;
        }
      };

      const getCartStorageKey = () => {
        const session = readSession();
        const user = session?.user ? String(session.user).trim().toLowerCase() : "";
        return user ? `${CART_STORAGE_PREFIX}:user:${user}` : `${CART_STORAGE_PREFIX}:anon`;
      };

      try {
        window.localStorage.removeItem(CART_STORAGE_PREFIX);
      } catch {
        // Ignore storage failures; session-scoped cart keys still work when storage is available.
      }

      const content: Record<string, { title: string; copy: string }> = {
        success: {
          title: "Pago recibido",
          copy: "Mercado Pago aprobo el pago. Estamos confirmando el estado del pedido."
        },
        approved: {
          title: "Pago recibido",
          copy: "Mercado Pago aprobo el pago y el pedido quedo marcado como pagado."
        },
        failure: {
          title: "Pago no completado",
          copy: "Mercado Pago no pudo completar el pago. Puedes intentar nuevamente desde tu pedido."
        },
        rejected: {
          title: "Pago rechazado",
          copy: "Mercado Pago rechazo el pago. Revisa el medio de pago o intenta con otra opcion."
        },
        pending: {
          title: "Pago pendiente",
          copy: "Mercado Pago dejo el pago pendiente. El pedido se actualizara cuando el proveedor confirme el resultado."
        }
      };

      const selected = content[status] ?? content.pending;
      if (title instanceof HTMLElement) title.textContent = selected.title;
      if (copy instanceof HTMLElement) copy.textContent = selected.copy;
      if (order instanceof HTMLElement && orderId) {
        order.textContent = `Pedido ${orderId}`;
        order.classList.remove("hidden");
      }

      const syncPayment = async () => {
        if (!paymentId || paymentId === "null") return;

        try {
          const response = await fetch(
            `${API_BASE_URL}/api/payments/mercadopago/sync?payment_id=${encodeURIComponent(paymentId)}`
          );
          const payload = await response.json().catch(() => null);
          const syncedStatus = payload?.data?.status;
          if (!response.ok || !syncedStatus) return;

          const syncedContent = content[syncedStatus] ?? content.pending;
          if (title instanceof HTMLElement) title.textContent = syncedContent.title;
          if (copy instanceof HTMLElement) copy.textContent = syncedContent.copy;
          if (order instanceof HTMLElement && payload.data.order_id) {
            order.textContent = `Pedido ${payload.data.order_id}`;
            order.classList.remove("hidden");
          }
          if (syncedStatus === "approved") {
            window.localStorage.removeItem(getCartStorageKey());
          }
        } catch {
          if (copy instanceof HTMLElement) {
            copy.textContent = "No pudimos sincronizar el pago automaticamente. El webhook de Mercado Pago lo volvera a intentar.";
          }
        }
      };

      syncPayment();
    </script>
  </body>
</html>
