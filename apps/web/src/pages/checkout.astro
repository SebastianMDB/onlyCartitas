---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Checkout | OnlyCartitas"
      description="Procesa el pago de tu carrito en OnlyCartitas con datos de contacto, entrega y resumen del pedido."
      noindex
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-16">
      <section class="mx-auto grid w-full max-w-7xl gap-8 px-4 pt-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_440px] lg:px-8">
        <form class="rounded-[2rem] border border-slate-200/80 bg-white/90 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-7" data-checkout-form>
          <div class="flex flex-col gap-2 border-b border-slate-200 pb-5">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Checkout</p>
            <h1 class="text-3xl font-semibold tracking-tight text-[color:var(--color-primary)] sm:text-4xl">Finalizar compra</h1>
            <p class="text-sm leading-6 text-slate-500">Completa tus datos para preparar el pedido y confirmar el pago.</p>
          </div>

          <div class="mt-7 grid gap-8">
            <section class="grid gap-4">
              <div class="flex items-center justify-between gap-4">
                <h2 class="text-xl font-semibold text-[color:var(--color-primary)]">Contacto</h2>
                <a href="/login" class="text-sm font-semibold text-[color:var(--color-secondary)] hover:underline">Iniciar sesión</a>
              </div>
              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Correo electronico *</span>
                <input data-required data-checkout-email type="email" autocomplete="email" placeholder="Correo electronico" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
              </label>
              <label class="flex items-center gap-3 text-sm text-slate-600">
                <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-[color:var(--color-primary)]" />
                Enviarme novedades y ofertas por correo electronico
              </label>
            </section>

            <section class="grid gap-4">
              <h2 class="text-xl font-semibold text-[color:var(--color-primary)]">Entrega</h2>
              <div class="grid rounded-2xl bg-slate-100 p-1 sm:grid-cols-2" data-delivery-tabs>
                <button type="button" class="rounded-[1rem] bg-white px-4 py-3 text-sm font-semibold text-slate-950 shadow-sm" data-delivery-option="envio" aria-pressed="true">Envío</button>
                <button type="button" class="rounded-[1rem] px-4 py-3 text-sm font-semibold text-slate-600 transition hover:text-slate-950" data-delivery-option="retiro" aria-pressed="false">Retiro</button>
              </div>

              <div class="grid gap-3 sm:grid-cols-2">
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Nombre *</span>
                  <input data-required data-checkout-first-name type="text" autocomplete="given-name" placeholder="Nombre" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Apellidos *</span>
                  <input data-required data-checkout-last-name type="text" autocomplete="family-name" placeholder="Apellidos" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                </label>
              </div>

              <div class="grid gap-3" data-address-fields>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Pais *</span>
                  <select data-required class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                    <option>Chile</option>
                  </select>
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">RUT *</span>
                  <input data-required type="text" placeholder="RUT" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Region *</span>
                  <select data-required data-checkout-region class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                    <option value="">Selecciona región</option>
                  </select>
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Comuna *</span>
                  <select data-required data-checkout-comuna class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                    <option value="">Selecciona comuna</option>
                  </select>
                </label>
                <label class="hidden" data-shipping-sector-field>
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Sector *</span>
                  <select data-checkout-sector class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                    <option value="">Selecciona sector</option>
                  </select>
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Direccion *</span>
                  <input data-required data-checkout-address type="text" autocomplete="street-address" placeholder="Direccion" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Direccion 2</span>
                  <input data-checkout-address-detail type="text" placeholder="Casa, departamento, etc. (opcional)" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                </label>
              </div>

              <div class="hidden rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600" data-pickup-info>
                Retiro gratis en Antofagasta. Te hablaremos por WhatsApp para coordinar el encuentro después de confirmar el pedido.
              </div>

              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Telefono *</span>
                <input data-required data-checkout-phone type="tel" autocomplete="tel" placeholder="Telefono" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
              </label>
            </section>

            <section class="grid gap-4">
              <h2 class="text-xl font-semibold text-[color:var(--color-primary)]">Pago</h2>
              <div class="rounded-2xl border border-slate-300 bg-white p-4">
                <p class="text-sm font-semibold text-slate-950">Mercado Pago</p>
                <p class="mt-1 text-sm leading-6 text-slate-600">Paga con tarjetas, saldo o medios disponibles en Mercado Pago.</p>
              </div>
              <p class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-600">
                Al confirmar, crearemos el pedido y te redirigiremos a Mercado Pago para completar el pago.
              </p>
              <label class="flex items-start gap-3 text-sm leading-6 text-slate-600">
                <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300" data-terms-check />
                <span>Acepto las <a href="/politicas" class="font-semibold text-[color:var(--color-primary)] hover:underline">políticas de compra, envío y devoluciones</a>.</span>
              </label>
            </section>
          </div>

          <p class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" data-checkout-error>
            Completa los campos requeridos, acepta las políticas y revisa que el carrito tenga productos.
          </p>

          <button type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f]" data-pay-button>
            Pagar pedido
          </button>
        </form>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-[2rem] border border-slate-200/80 bg-white/90 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-6">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Resumen</p>
                <h2 class="mt-1 text-2xl font-semibold text-[color:var(--color-primary)]">Tu pedido</h2>
              </div>
              <a href="/ofertas" class="text-sm font-semibold text-slate-500 hover:text-slate-950">Seguir comprando</a>
            </div>

            <div class="mt-5 grid gap-4" data-summary-items></div>

            <div class="mt-5 hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center" data-empty-checkout>
              <p class="text-base font-semibold text-[color:var(--color-primary)]">Tu carrito está vacío</p>
              <p class="mt-2 text-sm text-slate-500">Agrega productos antes de pagar.</p>
              <a href="/ofertas" class="mt-4 inline-flex rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white">Ver productos</a>
            </div>

            <div class="mt-5 grid grid-cols-[1fr_auto] gap-3">
              <input type="text" placeholder="Codigo de descuento" class="h-12 min-w-0 rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" data-discount-code />
              <button type="button" class="rounded-2xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950" data-apply-discount>Aplicar</button>
            </div>
            <p class="mt-2 hidden text-sm font-semibold text-emerald-700" data-discount-message>Descuento aplicado.</p>

            <dl class="mt-6 grid gap-3 border-t border-slate-200 pt-5 text-sm">
              <div class="flex items-center justify-between gap-4">
                <dt class="text-slate-600">Subtotal</dt>
                <dd class="font-semibold text-slate-950" data-summary-subtotal>$0</dd>
              </div>
              <div class="flex items-center justify-between gap-4">
                <dt class="text-slate-600">Envio</dt>
                <dd class="font-semibold text-slate-950" data-summary-shipping>Por calcular</dd>
              </div>
              <p class="hidden rounded-2xl bg-slate-50 px-4 py-3 text-xs font-semibold leading-5 text-slate-500" data-summary-shipping-note>
                Envío por pagar. Te contactaremos según tu región para coordinar.
              </p>
              <div class="flex items-center justify-between gap-4">
                <dt class="text-slate-600">Descuento</dt>
                <dd class="font-semibold text-emerald-700" data-summary-discount>$0</dd>
              </div>
              <div class="flex items-end justify-between gap-4 border-t border-slate-200 pt-4">
                <dt>
                  <span class="block text-lg font-semibold text-[color:var(--color-primary)]">Total</span>
                  <span class="mt-1 block text-xs text-slate-500">Incluye impuestos cuando correspondan</span>
                </dt>
                <dd class="text-2xl font-semibold text-[color:var(--color-primary)]" data-summary-total>$0</dd>
              </div>
            </dl>
          </div>
        </aside>
      </section>

      <section class="mx-auto hidden w-full max-w-xl px-4 pt-10 sm:px-6 lg:px-8" data-success-state>
        <div class="rounded-[2rem] border border-emerald-200 bg-white/90 p-6 text-center shadow-[0_20px_60px_rgba(17,48,71,0.08)]">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-emerald-700">Pedido creado</p>
          <h2 class="mt-2 text-3xl font-semibold text-[color:var(--color-primary)]">Compra registrada</h2>
          <p class="mt-2 text-lg font-semibold text-emerald-700" data-success-order></p>
          <p class="mt-3 text-sm leading-6 text-slate-600">Guardamos el pedido en el backend. El carrito quedó limpio.</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">No pudimos abrir Mercado Pago. El pedido quedó pendiente para intentar el pago nuevamente.</p>
          <p class="mt-2 hidden text-sm leading-6 text-slate-600" data-success-payment-note>
            Revisa que las credenciales de Mercado Pago esten configuradas en el API.
          </p>
          <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="/cuenta" class="inline-flex rounded-full bg-[#071c2b] px-6 py-3 text-sm font-semibold text-white">Ver mi cuenta</a>
            <a href="/" class="inline-flex rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700">Volver al inicio</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      type DeliveryMode = "envio" | "retiro";
      type AppliedDiscount = {
        code: string;
        discount: number;
      };
      type ShippingSector = {
        id: string;
        name: string;
        price: number;
        active: boolean;
      };

      const CART_STORAGE_PREFIX = "carta-noble-cart";
      const SESSION_STORAGE_KEY = "onlycartitas-auth-session";
      const API_BASE_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
      const FREE_ANTOFAGASTA_SHIPPING_THRESHOLD = 90_000;
      const COMMUNES_BY_REGION: Record<string, string[]> = {
        "Arica y Parinacota": ["Arica", "Camarones", "Putre", "General Lagos"],
        Tarapaca: ["Iquique", "Alto Hospicio", "Pozo Almonte", "Camina", "Colchane", "Huara", "Pica"],
        Antofagasta: ["Antofagasta", "Mejillones", "Sierra Gorda", "Taltal", "Calama", "Ollague", "San Pedro de Atacama", "Tocopilla", "Maria Elena"],
        Atacama: ["Copiapo", "Caldera", "Tierra Amarilla", "Chanaral", "Diego de Almagro", "Vallenar", "Alto del Carmen", "Freirina", "Huasco"],
        Coquimbo: ["La Serena", "Coquimbo", "Andacollo", "La Higuera", "Paiguano", "Vicuna", "Illapel", "Canela", "Los Vilos", "Salamanca", "Ovalle", "Combarbala", "Monte Patria", "Punitaqui", "Rio Hurtado"],
        Valparaiso: ["Valparaiso", "Casablanca", "Concon", "Juan Fernandez", "Puchuncavi", "Quintero", "Vina del Mar", "Isla de Pascua", "Los Andes", "Calle Larga", "Rinconada", "San Esteban", "La Ligua", "Cabildo", "Papudo", "Petorca", "Zapallar", "Quillota", "Calera", "Hijuelas", "La Cruz", "Nogales", "San Antonio", "Algarrobo", "Cartagena", "El Quisco", "El Tabo", "Santo Domingo", "San Felipe", "Catemu", "Llaillay", "Panquehue", "Putaendo", "Santa Maria", "Quilpue", "Limache", "Olmue", "Villa Alemana"],
        "Metropolitana de Santiago": ["Santiago", "Cerrillos", "Cerro Navia", "Conchali", "El Bosque", "Estacion Central", "Huechuraba", "Independencia", "La Cisterna", "La Florida", "La Granja", "La Pintana", "La Reina", "Las Condes", "Lo Barnechea", "Lo Espejo", "Lo Prado", "Macul", "Maipu", "Nunoa", "Pedro Aguirre Cerda", "Penalolen", "Providencia", "Pudahuel", "Quilicura", "Quinta Normal", "Recoleta", "Renca", "San Joaquin", "San Miguel", "San Ramon", "Vitacura", "Puente Alto", "Pirque", "San Jose de Maipo", "Colina", "Lampa", "Tiltil", "San Bernardo", "Buin", "Calera de Tango", "Paine", "Melipilla", "Alhue", "Curacavi", "Maria Pinto", "San Pedro", "Talagante", "El Monte", "Isla de Maipo", "Padre Hurtado", "Penaflor"],
        "Libertador General Bernardo O'Higgins": ["Rancagua", "Codegua", "Coinco", "Coltauco", "Donihue", "Graneros", "Las Cabras", "Machali", "Malloa", "Mostazal", "Olivar", "Peumo", "Pichidegua", "Quinta de Tilcoco", "Rengo", "Requinoa", "San Vicente", "Pichilemu", "La Estrella", "Litueche", "Marchihue", "Navidad", "Paredones", "San Fernando", "Chepica", "Chimbarongo", "Lolol", "Nancagua", "Palmilla", "Peralillo", "Placilla", "Pumanque", "Santa Cruz"],
        Maule: ["Talca", "Constitucion", "Curepto", "Empedrado", "Maule", "Pelarco", "Pencahue", "Rio Claro", "San Clemente", "San Rafael", "Cauquenes", "Chanco", "Pelluhue", "Curico", "Hualane", "Licanten", "Molina", "Rauco", "Romeral", "Sagrada Familia", "Teno", "Vichuquen", "Linares", "Colbun", "Longavi", "Parral", "Retiro", "San Javier", "Villa Alegre", "Yerbas Buenas"],
        Nuble: ["Chillan", "Bulnes", "Chillan Viejo", "El Carmen", "Pemuco", "Pinto", "Quillon", "San Ignacio", "Yungay", "Quirihue", "Cobquecura", "Coelemu", "Ninhue", "Portezuelo", "Ranquil", "Treguaco", "San Carlos", "Coihueco", "Niquen", "San Fabian", "San Nicolas"],
        Biobio: ["Concepcion", "Coronel", "Chiguayante", "Florida", "Hualqui", "Lota", "Penco", "San Pedro de la Paz", "Santa Juana", "Talcahuano", "Tome", "Hualpen", "Lebu", "Arauco", "Canete", "Contulmo", "Curanilahue", "Los Alamos", "Tirua", "Los Angeles", "Antuco", "Cabrero", "Laja", "Mulchen", "Nacimiento", "Negrete", "Quilaco", "Quilleco", "San Rosendo", "Santa Barbara", "Tucapel", "Yumbel", "Alto Biobio"],
        "La Araucania": ["Temuco", "Carahue", "Cunco", "Curarrehue", "Freire", "Galvarino", "Gorbea", "Lautaro", "Loncoche", "Melipeuco", "Nueva Imperial", "Padre Las Casas", "Perquenco", "Pitrufquen", "Pucon", "Saavedra", "Teodoro Schmidt", "Tolten", "Vilcun", "Villarrica", "Cholchol", "Angol", "Collipulli", "Curacautin", "Ercilla", "Lonquimay", "Los Sauces", "Lumaco", "Puren", "Renaico", "Traiguen", "Victoria"],
        "Los Rios": ["Valdivia", "Corral", "Lanco", "Los Lagos", "Mafil", "Mariquina", "Paillaco", "Panguipulli", "La Union", "Futrono", "Lago Ranco", "Rio Bueno"],
        "Los Lagos": ["Puerto Montt", "Calbuco", "Cochamo", "Fresia", "Frutillar", "Los Muermos", "Llanquihue", "Maullin", "Puerto Varas", "Castro", "Ancud", "Chonchi", "Curaco de Velez", "Dalcahue", "Puqueldon", "Queilen", "Quellon", "Quemchi", "Quinchao", "Osorno", "Puerto Octay", "Purranque", "Puyehue", "Rio Negro", "San Juan de la Costa", "San Pablo", "Chaiten", "Futaleufu", "Hualaihue", "Palena"],
        "Aysen del General Carlos Ibanez del Campo": ["Coyhaique", "Lago Verde", "Aysen", "Cisnes", "Guaitecas", "Cochrane", "O'Higgins", "Tortel", "Chile Chico", "Rio Ibanez"],
        "Magallanes y de la Antartica Chilena": ["Punta Arenas", "Laguna Blanca", "Rio Verde", "San Gregorio", "Cabo de Hornos", "Antartica", "Porvenir", "Primavera", "Timaukel", "Natales", "Torres del Paine"]
      };

      const checkoutForm = document.querySelector("[data-checkout-form]");
      const summaryItems = document.querySelector("[data-summary-items]");
      const emptyCheckout = document.querySelector("[data-empty-checkout]");
      const addressFields = document.querySelector("[data-address-fields]");
      const pickupInfo = document.querySelector("[data-pickup-info]");
      const deliveryButtons = Array.from(document.querySelectorAll("[data-delivery-option]"));
      const discountInput = document.querySelector("[data-discount-code]");
      const discountButton = document.querySelector("[data-apply-discount]");
      const discountMessage = document.querySelector("[data-discount-message]");
      const checkoutError = document.querySelector("[data-checkout-error]");
      const successState = document.querySelector("[data-success-state]");
      const successOrder = document.querySelector("[data-success-order]");
      const successPaymentNote = document.querySelector("[data-success-payment-note]");
      const payButton = document.querySelector("[data-pay-button]");
      const termsCheck = document.querySelector("[data-terms-check]");
      const emailInput = document.querySelector("[data-checkout-email]");
      const firstNameInput = document.querySelector("[data-checkout-first-name]");
      const lastNameInput = document.querySelector("[data-checkout-last-name]");
      const addressInput = document.querySelector("[data-checkout-address]");
      const addressDetailInput = document.querySelector("[data-checkout-address-detail]");
      const comunaInput = document.querySelector("[data-checkout-comuna]");
      const regionInput = document.querySelector("[data-checkout-region]");
      const shippingSectorField = document.querySelector("[data-shipping-sector-field]");
      const shippingSectorInput = document.querySelector("[data-checkout-sector]");
      const phoneInput = document.querySelector("[data-checkout-phone]");
      const subtotalLabel = document.querySelector("[data-summary-subtotal]");
      const shippingLabel = document.querySelector("[data-summary-shipping]");
      const shippingNote = document.querySelector("[data-summary-shipping-note]");
      const discountLabel = document.querySelector("[data-summary-discount]");
      const totalLabel = document.querySelector("[data-summary-total]");
      let deliveryMode: DeliveryMode = "envio";
      let appliedDiscount: AppliedDiscount | null = null;
      let shippingSectors: ShippingSector[] = [];
      let showedPickupAlert = false;

      const currencyFormatter = new Intl.NumberFormat("es-CL", {
        style: "currency",
        currency: "CLP",
        maximumFractionDigits: 0
      });

      const isHTMLElement = (value: unknown) => value instanceof HTMLElement;
      const isInputElement = (value: unknown) => value instanceof HTMLInputElement;
      const isSelectElement = (value: unknown) => value instanceof HTMLSelectElement;
      const normalizeLocation = (value: unknown) =>
        String(value ?? "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim()
          .toLowerCase();

      const escapeHtml = (value: unknown) =>
        String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const getApiErrorMessage = (payload: any, fallback: string) => {
        const issue = Array.isArray(payload?.details) ? payload.details[0] : null;
        const field = Array.isArray(issue?.path) ? issue.path.join(".") : "";
        if (field === "customerName") return "Ingresa nombre y apellido para continuar.";
        if (issue?.message) return `${field ? `${field}: ` : ""}${issue.message}`;
        return payload?.error ?? fallback;
      };

      const readSession = () => {
        try {
          const storedSession = window.localStorage.getItem(SESSION_STORAGE_KEY);
          const session = storedSession ? JSON.parse(storedSession) : null;
          if (!session?.expiresAt || Date.now() > Number(session.expiresAt)) return null;
          return session;
        } catch {
          return null;
        }
      };

      const getCartStorageKey = () => {
        const session = readSession();
        const user = session?.user ? String(session.user).trim().toLowerCase() : "";
        return user ? `${CART_STORAGE_PREFIX}:user:${user}` : `${CART_STORAGE_PREFIX}:anon`;
      };

      try {
        window.localStorage.removeItem(CART_STORAGE_PREFIX);
      } catch {
        // Ignore storage failures; session-scoped cart keys still work when storage is available.
      }

      const readCart = () => {
        try {
          const storedCart = window.localStorage.getItem(getCartStorageKey());
          const parsedCart = storedCart ? JSON.parse(storedCart) : [];
          return Array.isArray(parsedCart)
            ? parsedCart.map((item) => ({
                ...item,
                price: Number(item.price ?? 0),
                quantity: Number(item.quantity ?? 1)
              }))
            : [];
        } catch {
          return [];
        }
      };

      const applySessionToForm = () => {
        const session = readSession();
        if (!session) return;
        if (firstNameInput instanceof HTMLInputElement && !firstNameInput.value) {
          firstNameInput.value = session.user ?? "";
        }
      };

      const loadShippingSectors = async () => {
        try {
          const response = await fetch(`${API_BASE_URL}/api/shipping-sectors`);
          const payload = await response.json().catch(() => null);
          if (!response.ok) throw new Error(payload?.error ?? "No se pudieron cargar los sectores.");
          shippingSectors = Array.isArray(payload.data)
            ? payload.data.map((sector) => ({ ...sector, price: Number(sector.price ?? 0) }))
            : [];
          renderShippingSectorOptions();
        } catch {
          shippingSectors = [];
          renderShippingSectorOptions();
        }
      };

      let cart = readCart();

      const getSubtotal = () => cart.reduce((total, item) => total + item.price * item.quantity, 0);
      const renderRegionOptions = () => {
        if (!isSelectElement(regionInput)) return;
        regionInput.innerHTML = [
          `<option value="">Selecciona región</option>`,
          ...Object.keys(COMMUNES_BY_REGION).map((region) => `<option value="${escapeHtml(region)}">${escapeHtml(region)}</option>`)
        ].join("");
      };
      const renderCommuneOptions = () => {
        if (!isSelectElement(comunaInput)) return;
        const region = isSelectElement(regionInput) ? regionInput.value : "";
        const communes = COMMUNES_BY_REGION[region] ?? [];
        comunaInput.innerHTML = [
          `<option value="">Selecciona comuna</option>`,
          ...communes.map((commune) => `<option value="${escapeHtml(commune)}">${escapeHtml(commune)}</option>`)
        ].join("");
        comunaInput.disabled = communes.length === 0;
        renderSummary();
      };
      const isAntofagastaDelivery = () => {
        const comuna = isSelectElement(comunaInput) ? comunaInput.value : "";
        const region = isSelectElement(regionInput) ? regionInput.value : "";
        return normalizeLocation(region) === "antofagasta" && normalizeLocation(comuna) === "antofagasta";
      };
      const getDiscount = () => Number(appliedDiscount?.discount ?? 0);
      const getSelectedShippingSector = () => {
        const sectorId = isSelectElement(shippingSectorInput) ? shippingSectorInput.value : "";
        return shippingSectors.find((sector) => sector.id === sectorId) ?? null;
      };
      const getShipping = () => {
        if (deliveryMode === "retiro" || cart.length === 0) return 0;
        if (isAntofagastaDelivery() && getSubtotal() > FREE_ANTOFAGASTA_SHIPPING_THRESHOLD) return 0;
        if (isAntofagastaDelivery()) return Number(getSelectedShippingSector()?.price ?? 0);
        return 0;
      };
      const getTotal = () => Math.max(0, getSubtotal() + getShipping() - getDiscount());
      const renderShippingSectorOptions = () => {
        if (!isSelectElement(shippingSectorInput)) return;
        shippingSectorInput.innerHTML = [
          `<option value="">Selecciona sector</option>`,
          ...shippingSectors.map((sector) => `<option value="${escapeHtml(sector.id)}">${escapeHtml(sector.name)} - ${currencyFormatter.format(Number(sector.price ?? 0))}</option>`)
        ].join("");
      };
      const updateShippingSectorVisibility = () => {
        const shouldShow = deliveryMode === "envio" && isAntofagastaDelivery();
        if (isHTMLElement(shippingSectorField)) shippingSectorField.classList.toggle("hidden", !shouldShow);
        if (isSelectElement(shippingSectorInput)) {
          shippingSectorInput.toggleAttribute("data-required", shouldShow);
          if (!shouldShow) shippingSectorInput.value = "";
        }
      };

      const renderSummary = () => {
        const subtotal = getSubtotal();
        updateShippingSectorVisibility();
        const shipping = getShipping();
        const discount = getDiscount();
        const total = getTotal();

        if (isHTMLElement(emptyCheckout)) emptyCheckout.classList.toggle("hidden", cart.length > 0);
        if (isHTMLElement(payButton)) {
          payButton.toggleAttribute("disabled", cart.length === 0);
          payButton.classList.toggle("opacity-45", cart.length === 0);
          payButton.classList.toggle("cursor-not-allowed", cart.length === 0);
        }
        if (isHTMLElement(subtotalLabel)) subtotalLabel.textContent = currencyFormatter.format(subtotal);
        if (isHTMLElement(shippingLabel)) {
          shippingLabel.textContent = deliveryMode === "envio" && !isAntofagastaDelivery()
            ? "Por pagar"
            : isAntofagastaDelivery() && getSubtotal() > FREE_ANTOFAGASTA_SHIPPING_THRESHOLD
              ? "Gratis"
              : isAntofagastaDelivery() && !getSelectedShippingSector()
                ? "Selecciona sector"
                : shipping > 0
                  ? currencyFormatter.format(shipping)
                  : "Gratis";
          shippingLabel.title = isAntofagastaDelivery()
            ? getSubtotal() > FREE_ANTOFAGASTA_SHIPPING_THRESHOLD
              ? "Envio gratis en Antofagasta sobre $90.000"
              : "Costo según sector seleccionado"
            : deliveryMode === "envio"
              ? "Envío por pagar. Te contactaremos según tu región."
              : "";
        }
        if (isHTMLElement(shippingNote)) {
          shippingNote.classList.toggle("hidden", !(deliveryMode === "envio" && !isAntofagastaDelivery()));
        }
        if (isHTMLElement(discountLabel)) discountLabel.textContent = `-${currencyFormatter.format(discount)}`;
        if (isHTMLElement(totalLabel)) totalLabel.textContent = currencyFormatter.format(total);
        if (!isHTMLElement(summaryItems)) return;

        summaryItems.innerHTML = cart
          .map(
            (item) => `
              <article class="grid grid-cols-[68px_1fr_auto] items-center gap-3">
                <div class="relative rounded-2xl bg-slate-50 p-2">
                  <img src="${escapeHtml(item.image ?? "")}" alt="${escapeHtml(item.name ?? "")}" class="h-16 w-full object-contain" loading="lazy" decoding="async" fetchpriority="low" />
                  <span class="absolute -right-2 -top-2 inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-[#071c2b] px-1.5 text-xs font-semibold text-white">${escapeHtml(item.quantity)}</span>
                </div>
                <div class="min-w-0">
                  <p class="line-clamp-2 text-sm font-semibold text-slate-950">${escapeHtml(item.name ?? "")}</p>
                  ${item.variantName ? `<p class="mt-1 text-xs font-semibold text-slate-700">Diseño: ${escapeHtml(item.variantName)}</p>` : ""}
                  <p class="mt-1 text-xs text-slate-500">${escapeHtml(item.set ?? "")} - ${escapeHtml(item.language ?? "")}</p>
                </div>
                <p class="text-sm font-semibold text-slate-950">${currencyFormatter.format(item.price * item.quantity)}</p>
              </article>
            `
          )
          .join("");
      };

      const setDeliveryMode = (mode: DeliveryMode) => {
        deliveryMode = mode;
        deliveryButtons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const isActive = button.dataset.deliveryOption === mode;
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
          button.className = isActive
            ? "rounded-[1rem] bg-white px-4 py-3 text-sm font-semibold text-slate-950 shadow-sm"
            : "rounded-[1rem] px-4 py-3 text-sm font-semibold text-slate-600 transition hover:text-slate-950";
        });
        if (isHTMLElement(addressFields)) addressFields.classList.toggle("hidden", mode !== "envio");
        if (isHTMLElement(pickupInfo)) pickupInfo.classList.toggle("hidden", mode !== "retiro");
        if (mode === "retiro" && !showedPickupAlert) {
          showedPickupAlert = true;
          window.alert("Te hablaremos por WhatsApp para coordinar el encuentro del retiro.");
        }
        renderSummary();
      };

      deliveryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (!(button instanceof HTMLButtonElement)) return;
          setDeliveryMode(button.dataset.deliveryOption === "retiro" ? "retiro" : "envio");
        });
      });

      if (isSelectElement(regionInput)) {
        regionInput.addEventListener("change", () => {
          renderCommuneOptions();
          renderSummary();
        });
      }

      if (isSelectElement(comunaInput)) {
        comunaInput.addEventListener("change", renderSummary);
      }

      if (isSelectElement(shippingSectorInput)) {
        shippingSectorInput.addEventListener("change", renderSummary);
      }

      discountButton?.addEventListener("click", async () => {
        const code = isInputElement(discountInput) ? discountInput.value.trim().toUpperCase() : "";
        appliedDiscount = null;

        try {
          const response = await fetch(`${API_BASE_URL}/api/discount-codes/validate`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              code,
              subtotal: getSubtotal()
            })
          });

          const payload = await response.json().catch(() => null);
          if (!response.ok) throw new Error(payload?.error ?? "Código no válido.");
          appliedDiscount = payload.data;

          if (isHTMLElement(discountMessage)) {
            discountMessage.textContent = "Descuento aplicado.";
            discountMessage.classList.toggle("hidden", false);
            discountMessage.classList.add("text-emerald-700");
            discountMessage.classList.remove("text-red-700");
          }
        } catch (error) {
          if (isHTMLElement(discountMessage)) {
            discountMessage.textContent = error instanceof Error ? error.message : "Código no válido.";
            discountMessage.classList.toggle("hidden", false);
            discountMessage.classList.remove("text-emerald-700");
            discountMessage.classList.add("text-red-700");
          }
        }

        renderSummary();
      });

      const createOrder = async () => {
        const firstName = firstNameInput instanceof HTMLInputElement ? firstNameInput.value.trim() : "";
        const lastName = lastNameInput instanceof HTMLInputElement ? lastNameInput.value.trim() : "";
        const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : "";
        const phone = phoneInput instanceof HTMLInputElement ? phoneInput.value.trim() : "";
        const address = addressInput instanceof HTMLInputElement ? addressInput.value.trim() : "";
        const addressDetail = addressDetailInput instanceof HTMLInputElement ? addressDetailInput.value.trim() : "";
        const comuna = isSelectElement(comunaInput) ? comunaInput.value.trim() : "";
        const city = comuna;
        const region = isSelectElement(regionInput) ? regionInput.value.trim() : "";
        const shippingSector = getSelectedShippingSector();
        const session = readSession();
        const response = await fetch(`${API_BASE_URL}/api/orders`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(session?.token ? { Authorization: `Bearer ${session.token}` } : {})
          },
          body: JSON.stringify({
            customerName: `${firstName} ${lastName}`.trim(),
            customerEmail: email,
            customerPhone: phone || undefined,
            deliveryMode,
            address: deliveryMode === "envio" ? [address, addressDetail, comuna, region].filter(Boolean).join(", ") : undefined,
            comuna: deliveryMode === "envio" ? comuna : undefined,
            city: deliveryMode === "envio" ? city : undefined,
            region: deliveryMode === "envio" ? region : undefined,
            shippingSectorId: deliveryMode === "envio" && isAntofagastaDelivery() ? shippingSector?.id : undefined,
            discountCode: appliedDiscount?.code,
            items: cart.map((item) => ({
              id: item.id,
              variantId: item.variantId,
              quantity: item.quantity
            }))
          })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          throw new Error(getApiErrorMessage(payload, "No se pudo crear el pedido."));
        }

        return payload.data;
      };

      const createMercadoPagoPreference = async (orderId: string) => {
        const session = readSession();
        const response = await fetch(`${API_BASE_URL}/api/payments/mercadopago/preferences`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(session?.token ? { Authorization: `Bearer ${session.token}` } : {})
          },
          body: JSON.stringify({ orderId })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          if (response.status === 503) return null;
          throw new Error(getApiErrorMessage(payload, "No se pudo iniciar Mercado Pago."));
        }

        return payload.data;
      };

      checkoutForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const requiredFields = Array.from(document.querySelectorAll("[data-required]")).filter((field) => {
          if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) return false;
          if (field === firstNameInput || field === lastNameInput) return true;
          return deliveryMode === "envio" || !isHTMLElement(addressFields) || !addressFields.contains(field);
        });
        const hasInvalidField = requiredFields.some((field) =>
          field instanceof HTMLInputElement || field instanceof HTMLSelectElement ? field.value.trim().length === 0 : false
        );
        const acceptedTerms = termsCheck instanceof HTMLInputElement && termsCheck.checked;
        const isInvalid = hasInvalidField || !acceptedTerms || cart.length === 0;

        checkoutError?.classList.toggle("hidden", !isInvalid);
        if (isInvalid) return;

        try {
          if (isHTMLElement(payButton)) {
            payButton.setAttribute("disabled", "");
            payButton.textContent = "Creando pedido...";
          }
          const order = await createOrder();
          const payment = await createMercadoPagoPreference(order.id);

          if (payment?.checkout_url) {
            if (isHTMLElement(payButton)) payButton.textContent = "Redirigiendo a Mercado Pago...";
            window.location.href = payment.checkout_url;
            return;
          }

          window.localStorage.removeItem(getCartStorageKey());
          cart = [];
          renderSummary();
          checkoutForm.classList.add("hidden");
          if (isHTMLElement(successOrder)) successOrder.textContent = `Orden ${order.id}`;
          if (isHTMLElement(successPaymentNote)) successPaymentNote.classList.remove("hidden");
          if (isHTMLElement(successState)) successState.classList.remove("hidden");
          window.scrollTo({ top: 0, behavior: "smooth" });
        } catch (error) {
          if (isHTMLElement(checkoutError)) {
            checkoutError.textContent = error instanceof Error ? error.message : "No se pudo crear el pedido.";
            checkoutError.classList.remove("hidden");
          }
        } finally {
          if (isHTMLElement(payButton)) {
            payButton.removeAttribute("disabled");
            payButton.textContent = "Pagar pedido";
          }
        }
      });

      const initCheckout = async () => {
        applySessionToForm();
        await loadShippingSectors();
        renderRegionOptions();
        if (isSelectElement(regionInput)) regionInput.value = "Antofagasta";
        renderCommuneOptions();
        setDeliveryMode("envio");
        renderSummary();
      };

      initCheckout();
    </script>
  </body>
</html>

