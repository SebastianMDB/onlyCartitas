---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import HeroBanner from "../components/HeroBanner.astro";
import { fetchProducts, serializeJsonForInlineScript } from "../lib/catalog";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
const initialProducts = await fetchProducts();
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="OnlyCartitas | Tienda Pokemon TCG en Chile"
      description="Compra cartas Pokemon TCG, singles, productos sellados y ofertas en OnlyCartitas. Catalogo con stock, precios en CLP y envio en Chile."
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header />

    <main class="pb-20">
      <HeroBanner products={[]} />

      <section id="productos" class="mx-auto mt-10 w-full max-w-7xl px-4 sm:mt-14 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-12" data-products-grid>
          <p class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-6 py-8 text-center text-sm font-semibold text-slate-600">
            Cargando productos...
          </p>
        </div>
        <div class="hidden rounded-[1.5rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center" data-empty-state>
          <p class="text-lg font-semibold text-[color:var(--color-primary)]">No hay productos disponibles</p>
          <p class="mt-2 text-sm text-slate-500">El catalogo se actualizara cuando se agreguen productos.</p>
        </div>
      </section>
    </main>
    <Footer />

    <script is:inline type="application/json" data-catalog-config set:html={JSON.stringify({ apiBaseUrl, layout: "home", columns: "four" })}></script>
    <script is:inline type="application/json" data-catalog-initial-products set:html={serializeJsonForInlineScript(initialProducts)}></script>
    <script>
      import "../scripts/catalog-runtime";
    </script>
  </body>
</html>
