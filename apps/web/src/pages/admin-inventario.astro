---
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { productCategories } from "../lib/catalog";
import "../styles/global.css";

const inventoryItems: any[] = [];
const apiBaseUrl = import.meta.env.PUBLIC_API_URL;
const defaultProductCategoryOptions = productCategories.sealed;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Admin inventario | OnlyCartitas"
      description="Panel simple para ajustar stock y activar o desactivar productos."
    />
  </head>
  <body class="bg-[color:var(--color-surface)] text-slate-900 antialiased">
    <Header adminMode />

    <section class="mx-auto w-full max-w-md px-4 pt-10 sm:px-6 lg:px-8" data-admin-login>
      <div class="rounded-[2rem] border border-slate-200/80 bg-white/90 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[color:var(--color-secondary)]">Acceso admin</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[color:var(--color-primary)]">Iniciar sesion</h1>
        <form class="mt-5 grid gap-4" data-admin-login-form>
          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Usuario</span>
            <input
              data-admin-user
              type="text"
              autocomplete="username"
              class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
            />
          </label>
          <label class="block">
            <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Clave</span>
            <input
              data-admin-password
              type="password"
              autocomplete="current-password"
              class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
            />
          </label>
          <p class="hidden rounded-[1rem] border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" data-admin-login-error>
            Usuario o clave incorrectos.
          </p>
          <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f]">
            Entrar
          </button>
        </form>
      </div>
    </section>

    <main class="hidden pb-20" data-admin-content>
      <section class="mx-auto w-full max-w-6xl px-4 pt-6 sm:px-6 lg:px-8">
        <div class="overflow-hidden rounded-[2rem] bg-[color:var(--color-primary)] px-6 py-8 text-white shadow-[0_28px_80px_rgba(17,48,71,0.22)] sm:px-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-300">Admin</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Panel admin</h1>
          <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
            Gestiona inventario, compras y codigos de descuento desde una sola vista.
          </p>
        </div>
      </section>

      <section class="mx-auto mt-6 w-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-2 rounded-2xl bg-slate-100 p-1 sm:grid-cols-5" data-admin-tabs>
          <button type="button" class="rounded-[1rem] bg-white px-4 py-3 text-sm font-semibold text-slate-950 shadow-sm" data-admin-tab="inventory" aria-pressed="true">Inventario</button>
          <button type="button" class="rounded-[1rem] px-4 py-3 text-sm font-semibold text-slate-600 transition hover:text-slate-950" data-admin-tab="users" aria-pressed="false">Usuarios</button>
          <button type="button" class="rounded-[1rem] px-4 py-3 text-sm font-semibold text-slate-600 transition hover:text-slate-950" data-admin-tab="orders" aria-pressed="false">Compras</button>
          <button type="button" class="rounded-[1rem] px-4 py-3 text-sm font-semibold text-slate-600 transition hover:text-slate-950" data-admin-tab="discounts" aria-pressed="false">Descuentos</button>
          <button type="button" class="rounded-[1rem] px-4 py-3 text-sm font-semibold text-slate-600 transition hover:text-slate-950" data-admin-tab="hero" aria-pressed="false">Hero</button>
        </div>
      </section>

      <section class="mx-auto mt-8 w-full max-w-6xl px-4 sm:px-6 lg:px-8" data-admin-panel="inventory">
        <div class="rounded-[2rem] border border-slate-200/80 bg-white/90 p-5 shadow-[0_20px_60px_rgba(17,48,71,0.08)] sm:p-6">
          <div class="grid gap-5">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-secondary)]">Inventario</p>
              <h2 class="mt-2 text-2xl font-semibold text-[color:var(--color-primary)]">Stock y visibilidad</h2>
            </div>

            <details class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-4" open>
              <summary class="cursor-pointer text-sm font-semibold text-[color:var(--color-primary)]">Crear producto</summary>
              <form class="mt-4 grid gap-4" data-product-create-form>
                <div class="grid gap-4 lg:grid-cols-2">
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Tipo</span>
                    <select data-product-create="kind" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                      <option value="sealed">Sellado</option>
                      <option value="single">Single</option>
                    </select>
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Nombre</span>
                    <input data-product-create="name" type="text" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Categoria</span>
                    <select data-product-create="category" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                      {defaultProductCategoryOptions.map((category) => <option value={category}>{category}</option>)}
                    </select>
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Set</span>
                    <input data-product-create="set" list="admin-set-options" type="text" placeholder="Journey Together" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Idioma</span>
                    <select data-product-create="language" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                      <option value="english">Ingles</option>
                      <option value="spanish">Espanol</option>
                      <option value="japanese">Japones</option>
                    </select>
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Imagen URL</span>
                    <input data-product-create="image" type="text" placeholder="https://.../product.webp" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Stock</span>
                    <input data-product-create="stock" type="number" min="0" step="1" value="0" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Valor ahora</span>
                    <input data-product-create="price" type="number" min="0" step="1" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                  </label>
                  <label class="flex min-h-12 items-center gap-3 rounded-2xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 lg:col-span-2">
                    <input data-product-offer-toggle type="checkbox" class="h-5 w-5 rounded border-slate-300 text-[color:var(--color-primary)] focus:ring-[color:var(--color-secondary)]" />
                    Producto en oferta
                  </label>
                  <div class="hidden grid gap-4 lg:col-span-2 lg:grid-cols-2" data-product-offer-fields>
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Valor anterior</span>
                      <input data-product-create="previousPrice" type="number" min="0" step="1" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                    </label>
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Etiqueta oferta</span>
                      <input data-product-create="offer" type="text" value="Oferta" placeholder="Oferta" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                    </label>
                  </div>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Ilustrador</span>
                    <input data-product-create="illustrator" list="admin-illustrator-options" type="text" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                  </label>
                  <label class="block lg:col-span-2">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Descripcion</span>
                    <textarea data-product-create="description" rows="3" placeholder="Texto que vera el cliente en la ficha del producto." class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"></textarea>
                  </label>
                  <div class="rounded-2xl border border-slate-200 bg-white p-4 lg:col-span-2" data-variant-builder="create">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                      <div>
                        <span class="block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Diseños y stock</span>
                      </div>
                      <button type="button" class="inline-flex min-h-10 items-center justify-center rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950" data-variant-add="create">
                        Agregar diseño
                      </button>
                    </div>
                    <div class="mt-4 grid gap-3" data-variant-list="create"></div>
                    <p class="mt-3 rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-500" data-variant-empty="create">Sin diseños. El producto se vendera como una sola opcion.</p>
                    <textarea data-product-create="variants" class="hidden" aria-hidden="true"></textarea>
                  </div>
                </div>
                <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f]">
                  Crear producto
                </button>
                <p class="hidden rounded-[1rem] bg-white px-4 py-3 text-sm font-semibold text-[color:var(--color-primary)]" data-product-create-message></p>
              </form>
            </details>

            <datalist id="admin-set-options" data-set-options></datalist>
            <datalist id="admin-category-options" data-category-options></datalist>
            <datalist id="admin-illustrator-options" data-illustrator-options></datalist>

            <details class="rounded-[1.5rem] border border-slate-200 bg-white p-4">
              <summary class="cursor-pointer text-sm font-semibold text-[color:var(--color-primary)]">Listas del catalogo</summary>
              <div class="mt-4 grid gap-4 lg:grid-cols-3">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Sets</p>
                  <div class="mt-3 grid grid-cols-[1fr_auto] gap-2">
                    <input data-option-input="sets" type="text" placeholder="Journey Together" class="h-11 min-w-0 rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                    <button type="button" class="rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950" data-option-add="sets">Agregar</button>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2" data-option-list="sets"></div>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Categorias</p>
                  <div class="mt-3 grid grid-cols-[1fr_auto] gap-2">
                    <input data-option-input="categories" type="text" placeholder="Latas" class="h-11 min-w-0 rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                    <button type="button" class="rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950" data-option-add="categories">Agregar</button>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2" data-option-list="categories"></div>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Ilustradores</p>
                  <div class="mt-3 grid grid-cols-[1fr_auto] gap-2">
                    <input data-option-input="illustrators" type="text" placeholder="Mitsuhiro Arita" class="h-11 min-w-0 rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                    <button type="button" class="rounded-full border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950" data-option-add="illustrators">Agregar</button>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2" data-option-list="illustrators"></div>
                </div>
              </div>
              <p class="mt-4 hidden rounded-[1rem] bg-[color:var(--color-surface)] px-4 py-3 text-sm font-semibold text-[color:var(--color-primary)]" data-options-message></p>
            </details>
            <div>
              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Tipo</span>
              <div class="grid gap-2 sm:grid-cols-2">
                <button type="button" class="rounded-full bg-[color:var(--color-primary)] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#173b56]" data-type-button data-type="sellado" aria-pressed="true">
                  Sellados
                  <span class="ml-2 rounded-full bg-white/15 px-2 py-0.5 text-xs" data-count-sellados>0</span>
                </button>
                <button type="button" class="rounded-full border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" data-type-button data-type="single" aria-pressed="false">
                  Singles
                  <span class="ml-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs" data-count-singles>0</span>
                </button>
              </div>
            </div>

            <div class="grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Filtrar producto</span>
                <input
                  data-search
                  type="search"
                  placeholder="Nombre, categoria o set"
                  class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15"
                />
              </label>

              <label class="block">
                <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Producto</span>
                <select data-product class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                  {inventoryItems.map((product) => <option value={product.id}>{product.name}</option>)}
                </select>
              </label>
            </div>

            <div class="grid gap-4 rounded-[1.5rem] border border-slate-200 bg-slate-50 p-4 sm:grid-cols-[1fr_auto] sm:items-center">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-secondary)]" data-product-type>
                  Sellado
                </p>
                <h2 class="mt-2 text-2xl font-semibold text-[color:var(--color-primary)]" data-product-name>
                  Producto
                </h2>
                <p class="mt-2 text-sm text-slate-500" data-product-meta>Categoria - Set</p>
              </div>
              <span class="w-fit rounded-full bg-[color:var(--color-surface)] px-4 py-2 text-sm font-semibold text-slate-700" data-status-badge>
                Activo
              </span>
            </div>

            <div class="grid gap-4 lg:grid-cols-[0.85fr_1.15fr]">
              <form class="rounded-[1.5rem] border border-slate-200 bg-white p-4" data-form>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-secondary)]">Stock</p>
                  <h3 class="mt-2 text-xl font-semibold text-[color:var(--color-primary)]">Movimiento rapido</h3>
                  <p class="mt-2 text-sm text-slate-500">Ajusta solo unidades y visibilidad del producto seleccionado.</p>
                </div>
                <div class="mt-4 grid gap-4">
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Stock exacto</span>
                    <div class="grid grid-cols-[44px_1fr_44px] gap-2">
                    <button type="button" class="inline-flex h-12 items-center justify-center rounded-full border border-slate-300 text-lg font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" data-stock-minus aria-label="Restar stock">
                      -
                    </button>
                    <input data-stock type="number" min="0" class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-center text-lg font-semibold text-slate-900 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                    <button type="button" class="inline-flex h-12 items-center justify-center rounded-full border border-slate-300 text-lg font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" data-stock-plus aria-label="Sumar stock">
                      +
                    </button>
                    </div>
                  </label>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Visibilidad</span>
                  <select data-status class="mt-3 h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                    <option value="active">Activo en tienda</option>
                    <option value="inactive">Inactivo / oculto</option>
                  </select>
                  </label>
                  <button type="button" class="mt-3 inline-flex min-h-11 w-full items-center justify-center rounded-full border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" data-toggle-status>
                    Cambiar estado
                  </button>
                  <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-[#071c2b] px-5 py-3 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(17,48,71,0.18)] transition hover:bg-[#0d2a3f]">
                    Guardar stock
                  </button>
                </div>
                <p class="hidden mt-4 rounded-[1rem] bg-[color:var(--color-surface)] px-4 py-3 text-sm font-semibold text-[color:var(--color-primary)]" data-message></p>
              </form>

              <form class="rounded-[1.5rem] border border-slate-200 bg-white p-4" data-product-edit-form>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[color:var(--color-secondary)]">Producto</p>
                  <h3 class="mt-2 text-xl font-semibold text-[color:var(--color-primary)]">Datos editables</h3>
                  <p class="mt-2 text-sm text-slate-500">Edita nombre, set, precio, imagen y atributos sin mezclarlo con stock.</p>
                </div>
                <div class="mt-4 grid gap-4 lg:grid-cols-2">
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Tipo</span>
