      const adminLogout = document.querySelector("[data-admin-logout]");
      const adminTabs = Array.from(document.querySelectorAll("[data-admin-tab]"));
      const adminPanels = Array.from(document.querySelectorAll("[data-admin-panel]"));
      const typeButtons = Array.from(document.querySelectorAll("[data-type-button]"));
      const searchInput = document.querySelector("[data-search]");
      const productSelect = document.querySelector("[data-product]");
      const productType = document.querySelector("[data-product-type]");
      const productName = document.querySelector("[data-product-name]");
      const productMeta = document.querySelector("[data-product-meta]");
      const statusBadge = document.querySelector("[data-status-badge]");
      const stockInput = document.querySelector("[data-stock]");
      const statusSelect = document.querySelector("[data-status]");
      const minusButton = document.querySelector("[data-stock-minus]");
      const plusButton = document.querySelector("[data-stock-plus]");
      const toggleButton = document.querySelector("[data-toggle-status]");
      const form = document.querySelector("[data-form]");
      const message = document.querySelector("[data-message]");
      const productEditForm = document.querySelector("[data-product-edit-form]");
      const productEditInputs = Array.from(document.querySelectorAll("[data-product-edit]"));
      const productEditMessage = document.querySelector("[data-product-edit-message]");
      const productCreateForm = document.querySelector("[data-product-create-form]");
      const productCreateInputs = Array.from(document.querySelectorAll("[data-product-create]"));
      const productCreateKindInput = document.querySelector('[data-product-create="kind"]');
      const productCreateCategoryInput = document.querySelector('[data-product-create="category"]');
      const productCreateOfferToggle = document.querySelector("[data-product-offer-toggle]");
      const productCreateOfferFields = document.querySelector("[data-product-offer-fields]");
      const productCreateMessage = document.querySelector("[data-product-create-message]");
      const setOptions = document.querySelector("[data-set-options]");
      const categoryOptions = document.querySelector("[data-category-options]");
      const illustratorOptions = document.querySelector("[data-illustrator-options]");
      const optionLists = Array.from(document.querySelectorAll("[data-option-list]"));
      const optionInputs = Array.from(document.querySelectorAll("[data-option-input]"));
      const optionsMessage = document.querySelector("[data-options-message]");
      const sealedCount = document.querySelector("[data-count-sellados]");
      const singlesCount = document.querySelector("[data-count-singles]");
      const usersContainer = document.querySelector("[data-admin-users]");
      const refreshUsersButton = document.querySelector("[data-refresh-users]");
      const userFilter = document.querySelector("[data-user-filter]");
      const userRoleFilter = document.querySelector("[data-user-role-filter]");
      const userAdminMessage = document.querySelector("[data-user-admin-message]");
      const ordersContainer = document.querySelector("[data-admin-orders]");
      const ordersEmpty = document.querySelector("[data-admin-orders-empty]");
      const refreshOrdersButton = document.querySelector("[data-refresh-orders]");
      const orderUserFilter = document.querySelector("[data-order-user-filter]");
      const orderStatusFilter = document.querySelector("[data-order-status-filter]");
      const orderFilterSummary = document.querySelector("[data-order-filter-summary]");
      const discountsContainer = document.querySelector("[data-admin-discounts]");
      const discountForm = document.querySelector("[data-discount-form]");
      const discountCodeInput = document.querySelector("[data-discount-code-input]");
      const discountTypeInput = document.querySelector("[data-discount-type-input]");
      const discountValueInput = document.querySelector("[data-discount-value-input]");
      const discountMaxInput = document.querySelector("[data-discount-max-input]");
      const discountAdminMessage = document.querySelector("[data-discount-admin-message]");
      const heroForm = document.querySelector("[data-hero-form]");
      const heroInputs = Array.from(document.querySelectorAll("[data-hero-input]"));
      const heroPreview = document.querySelector("[data-hero-preview]");
      const heroMessage = document.querySelector("[data-hero-message]");

      const isElement = (value) => value instanceof HTMLElement;
      const isInput = (value) => value instanceof HTMLInputElement;
      const isSelect = (value) => value instanceof HTMLSelectElement;
      const currencyFormatter = new Intl.NumberFormat("es-CL", {
        style: "currency",
        currency: "CLP",
        maximumFractionDigits: 0
      });
      const statusLabels = {
        pending: "Pendiente",
        paid: "Pagado",
        preparing: "Preparando",
        shipped: "Enviado",
        completed: "Completado",
        cancelled: "Cancelado"
      };

      let productMap = new Map(inventoryItems.map((product) => [product.id, product]));
      let activeType = "sellado";
      let activeAdminTab = "inventory";
      let adminOrders = [];
      let adminUsers = [];
      let usersReadOnly = false;
      let heroSettings = null;
      let catalogOptions = {
        sets: [],
        categories: Object.values(productCategoryOptions).flat(),
        illustrators: []
      };
      let catalogOptionsWritable = true;

      const mapProductForAdmin = (product) => ({
        id: product.id,
        kind: product.kind,
        type: product.kind === "single" ? "single" : "sellado",
        typeLabel: product.kind === "single" ? "Single" : "Sellado",
        name: product.name,
        category: product.category,
        description: product.description ?? "",
        set: product.set,
        language: product.language,
        stock: product.stock,
        price: product.price,
        previousPrice: product.previousPrice ?? null,
        image: product.image,
        offer: product.offer ?? null,
        active: product.active,
        illustrator: product.illustrator ?? "",
        rarity: product.rarity ?? "",
        playability: product.playability ?? "",
        marketPrice: product.marketPrice ?? null,
        manualSegment: product.manualSegment ?? "",
        variants: Array.isArray(product.variants) ? product.variants : []
      });

      const replaceInventoryItems = (products) => {
        inventoryItems = Array.isArray(products) ? products.map(mapProductForAdmin) : [];
        productMap = new Map(inventoryItems.map((product) => [product.id, product]));
        renderDynamicOptions();
        renderProductOptions();
        updateTypeButtons();
      };

      const readSession = () => {
        try {
          const storedSession = window.localStorage.getItem(SESSION_KEY);
          const session = storedSession ? JSON.parse(storedSession) : null;
          const isValidSession = Number(session?.expiresAt) > Date.now();

          if (!isValidSession) window.localStorage.removeItem(SESSION_KEY);
          return isValidSession ? session : null;
        } catch {
          window.localStorage.removeItem(SESSION_KEY);
          return null;
        }
      };

      const verifyAdminSession = async () => {
        const session = readSession();
        if (!session?.token || session.role !== "admin") return null;

        try {
          const response = await fetch(`${API_BASE_URL}/api/auth/me`, {
            headers: {
              Authorization: `Bearer ${session.token}`
            }
          });
          const payload = await response.json().catch(() => null);
          if (!response.ok) {
            if (response.status === 401 || response.status === 403) {
              window.localStorage.removeItem(SESSION_KEY);
              return null;
            }
            return session;
          }
          if (payload?.user?.role !== "admin") {
            window.localStorage.removeItem(SESSION_KEY);
            return null;
          }

          return session;
        } catch {
          return session;
        }
      };

      const createAdminSession = ({ user, token, expiresAt }) => {
        window.localStorage.setItem(
          SESSION_KEY,
          JSON.stringify({
            user: user.username,
            role: user.role,
            token,
            expiresAt: new Date(expiresAt).getTime()
          })
        );
      };

      const loginAdmin = async (username, password) => {
        const response = await fetch(`${API_BASE_URL}/api/auth/login`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ username, password })
        });

        if (!response.ok) {
          throw new Error("Usuario o clave incorrectos.");
        }

        const payload = await response.json();
        if (payload.user?.role !== "admin") {
          throw new Error("Permisos insuficientes.");
        }

        return payload;
      };

      const updateInventory = async (product, productState) => {
        const session = readSession();
        if (!session?.token) throw new Error("Sesion admin requerida.");

        const response = await fetch(`${API_BASE_URL}/api/products/${product.id}/inventory`, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${session.token}`
          },
          body: JSON.stringify({
            stock: productState.stock,
            active: productState.status === "active"
          })
        });

        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          throw new Error(payload?.error ?? "No se pudo actualizar el inventario.");
        }

        return payload.data;
      };

      const sameProductIdentity = (product, input) =>
        String(product?.kind ?? "") === String(input.kind ?? "") &&
        String(product?.name ?? "").trim().toLowerCase() === String(input.name ?? "").trim().toLowerCase() &&
        String(product?.category ?? "").trim().toLowerCase() === String(input.category ?? "").trim().toLowerCase() &&
        String(product?.set ?? "").trim().toLowerCase() === String(input.set ?? "").trim().toLowerCase();

      const updateProductDetails = async (product, input) => {
        const patchProduct = async (targetProduct) => {
          const response = await fetch(`${API_BASE_URL}/api/products/${targetProduct.id}`, {
            method: "PATCH",
            headers: authHeaders(),
            body: JSON.stringify(input)
          });
          const payload = await response.json().catch(() => null);
          return { response, payload };
        };

        let { response, payload } = await patchProduct(product);

        if (response.status === 404) {
          const products = await loadInventoryProducts();
          const fallbackProduct = products
            .map(mapProductForAdmin)
            .find((candidate) => sameProductIdentity(candidate, input) || sameProductIdentity(candidate, product));
          if (fallbackProduct && fallbackProduct.id !== product.id) {
            productMap.set(fallbackProduct.id, fallbackProduct);
            if (isSelect(productSelect)) productSelect.value = fallbackProduct.id;
            ({ response, payload } = await patchProduct(fallbackProduct));
          }
        }

        if (!response.ok) {
          throw new Error(getProductCreateError(payload));
        }

        return payload.data;
      };

      const authHeaders = () => {
        const session = readSession();
        if (!session?.token) throw new Error("Sesion admin requerida.");
        return {
          "Content-Type": "application/json",
          Authorization: `Bearer ${session.token}`
        };
      };

      const loadInventoryProducts = async () => {
        try {
          const response = await fetch(`${API_BASE_URL}/api/products?includeInactive=true`, {
            headers: authHeaders()
          });
          const payload = await response.json().catch(() => null);
          if (!response.ok) throw new Error(payload?.error ?? "No se pudieron cargar los productos.");
          replaceInventoryItems(payload?.data);
          return Array.isArray(payload?.data) ? payload.data : [];
        } catch (error) {
          replaceInventoryItems([]);
          showMessage(error instanceof Error ? error.message : "No se pudieron cargar los productos.");
          return [];
        }
      };

      let latestAdminSessionRenderId = 0;
      const loadAdminData = () => {
        loadInventoryProducts();
        loadUsers();
        loadOrders();
        loadDiscounts();
        loadHeroSettings();
        loadCatalogOptions();
      };

      const renderAdminSession = async () => {
        const renderId = ++latestAdminSessionRenderId;
        const localSession = readSession();
        const hasLocalAdminSession = Boolean(localSession?.token && localSession.role === "admin");

        adminLogin?.classList.toggle("hidden", hasLocalAdminSession);
        adminContent?.classList.toggle("hidden", !hasLocalAdminSession);

        const session = await verifyAdminSession();
        if (renderId !== latestAdminSessionRenderId) return;

        const isLoggedIn = Boolean(session);

        adminLogin?.classList.toggle("hidden", isLoggedIn);
        adminContent?.classList.toggle("hidden", !isLoggedIn);
        if (isLoggedIn) loadAdminData();
      };

      const readState = () => {
        try {
          const stored = window.localStorage.getItem(STORAGE_KEY);
          return stored ? JSON.parse(stored) : {};
        } catch {
          return {};
        }
      };

      const state = readState();

      const getProductState = (product) => ({
        stock: Number(state[product.id]?.stock ?? product.stock),
        status: state[product.id]?.status ?? (product.active === false ? "inactive" : "active")
      });

      const saveState = () => {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      };

      const showMessage = (text) => {
        if (!isElement(message)) return;

        message.textContent = text;
        message.classList.remove("hidden");
        window.setTimeout(() => message.classList.add("hidden"), 1800);
      };

      const showProductCreateMessage = (text) => {
        if (!isElement(productCreateMessage)) return;

        productCreateMessage.textContent = text;
        productCreateMessage.classList.remove("hidden");
        window.setTimeout(() => productCreateMessage.classList.add("hidden"), 3600);
      };

      const showProductEditMessage = (text) => {
        if (!isElement(productEditMessage)) return;

        productEditMessage.textContent = text;
        productEditMessage.classList.remove("hidden");
        window.setTimeout(() => productEditMessage.classList.add("hidden"), 2600);
      };

      const showUserMessage = (text) => {
        if (!isElement(userAdminMessage)) return;

        userAdminMessage.textContent = text;
        userAdminMessage.classList.remove("hidden");
        window.setTimeout(() => userAdminMessage.classList.add("hidden"), 2600);
      };

      const renderProductCreateOfferFields = () => {
        const hasOffer = productCreateOfferToggle instanceof HTMLInputElement && productCreateOfferToggle.checked;
        productCreateOfferFields?.classList.toggle("hidden", !hasOffer);

        const offerInput = productCreateInputs.find(
          (input) => input instanceof HTMLInputElement && input.dataset.productCreate === "offer"
        );
        if (hasOffer && offerInput instanceof HTMLInputElement && !offerInput.value.trim()) {
          offerInput.value = "Oferta";
        }
      };

      const getProductCreateError = (payload) => {
        const issue = Array.isArray(payload?.details) ? payload.details[0] : null;
        const field = Array.isArray(issue?.path) ? issue.path.join(".") : "";
        if (field === "image") return "La imagen debe ser una URL http/https o una ruta local que empiece con /.";
        if (field === "price") return "El precio debe ser un numero valido mayor o igual a 0.";
        if (field === "previousPrice") return "El precio anterior debe quedar vacio o ser un numero valido.";
        if (field === "marketPrice") return "El precio mercado debe quedar vacio o ser un numero valido.";
        if (field.startsWith("variants")) return "Revisa los diseños: cada linea necesita nombre y stock valido.";
        if (issue?.message) return `${field ? `${field}: ` : ""}${issue.message}`;
        return payload?.error ?? "No se pudo crear el producto.";
      };

      const createProductId = (name) => {
        const slug = String(name ?? "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 80);

        return slug || `producto-${Date.now().toString(36)}`;
      };

      const createVariantId = (name, index) => {
        const slug = String(name ?? "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 70);

        return slug || `diseno-${index + 1}`;
      };

      const parseVariants = (value) => {
        const lines = String(value ?? "")
          .split("\n")
          .map((line) => line.trim())
          .filter(Boolean);

        if (lines.length === 0) return null;

        const usedIds = new Set();
        return lines.map((line, index) => {
          const [rawName, rawStock = "0", rawStatus = "activo"] = line.split("|").map((part) => part.trim());
          const stock = Number(rawStock);
          if (!rawName || !Number.isFinite(stock) || stock < 0) {
            throw new Error("Revisa los diseños: usa Nombre | stock | activo/inactivo.");
          }
          let id = createVariantId(rawName, index);
          while (usedIds.has(id)) id = `${id}-${index + 1}`;
          usedIds.add(id);
          return {
            id,
            name: rawName,
            stock: Math.floor(stock),
            active: !["inactivo", "inactive", "oculto", "false", "0"].includes(rawStatus.toLowerCase())
          };
        });
      };

      const variantsToText = (variants) =>
        Array.isArray(variants)
          ? variants
              .map((variant) => `${variant.name} | ${Number(variant.stock ?? 0)} | ${variant.active === false ? "inactivo" : "activo"}`)
              .join("\n")
          : "";

      const showDiscountMessage = (text) => {
        if (!isElement(discountAdminMessage)) return;

        discountAdminMessage.textContent = text;
        discountAdminMessage.classList.remove("hidden");
        window.setTimeout(() => discountAdminMessage.classList.add("hidden"), 1800);
      };

      const showHeroMessage = (text) => {
        if (!isElement(heroMessage)) return;

        heroMessage.textContent = text;
        heroMessage.classList.remove("hidden");
        window.setTimeout(() => heroMessage.classList.add("hidden"), 2200);
      };

      const showOptionsMessage = (text) => {
        if (!isElement(optionsMessage)) return;

        optionsMessage.textContent = text;
        optionsMessage.classList.remove("hidden");
        window.setTimeout(() => optionsMessage.classList.add("hidden"), 2200);
      };

      const escapeHtml = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const getVariantHiddenInput = (scope) =>
        document.querySelector(`[data-product-${scope === "create" ? "create" : "edit"}="variants"]`);

      const collectVariantRows = (scope) =>
        Array.from(document.querySelectorAll(`[data-variant-builder="${scope}"] [data-variant-row]`)).map((row) => {
          const nameInput = row.querySelector("[data-variant-name]");
          const stockInput = row.querySelector("[data-variant-stock]");
          const statusInput = row.querySelector("[data-variant-status]");
          return {
            id: row instanceof HTMLElement ? row.dataset.variantId ?? "" : "",
            name: nameInput instanceof HTMLInputElement ? nameInput.value.trim() : "",
            stock: stockInput instanceof HTMLInputElement ? Number(stockInput.value) : 0,
            active: statusInput instanceof HTMLSelectElement ? statusInput.value !== "inactive" : true
          };
        });

      const normalizeVariantRows = (scope) => {
        const usedIds = new Set();
        return collectVariantRows(scope)
          .filter((variant) => variant.name || Number(variant.stock) > 0)
          .map((variant, index) => {
            const stock = Number(variant.stock);
            if (!variant.name || !Number.isFinite(stock) || stock < 0) {
              throw new Error("Revisa los diseños: cada fila necesita nombre y stock valido.");
            }
            let id = String(variant.id || createVariantId(variant.name, index));
            while (usedIds.has(id)) id = `${id}-${index + 1}`;
            usedIds.add(id);
            return {
              id,
              name: variant.name,
              stock: Math.floor(stock),
              active: variant.active !== false
            };
          });
      };

      const hasVariantRows = (scope) =>
        collectVariantRows(scope).some((variant) => variant.name || Number(variant.stock) > 0);

      const syncStockFromVariantRows = (scope) => {
        if (scope !== "edit" || !isInput(stockInput)) return;
        const variants = collectVariantRows(scope).filter((variant) => variant.name || Number(variant.stock) > 0);
        if (variants.length === 0) return;
        const total = variants.reduce(
          (sum, variant) => sum + (variant.active === false ? 0 : Math.max(0, Math.floor(Number(variant.stock) || 0))),
          0
        );
        stockInput.value = String(total);
        syncStatusWithStock();
      };

      const syncVariantText = (scope) => {
        const hiddenInput = getVariantHiddenInput(scope);
        if (!(hiddenInput instanceof HTMLTextAreaElement)) return;
        hiddenInput.value = collectVariantRows(scope)
          .filter((variant) => variant.name || Number(variant.stock) > 0)
          .map((variant) => `${variant.name} | ${Number.isFinite(variant.stock) ? Math.max(0, Math.floor(variant.stock)) : 0} | ${variant.active ? "activo" : "inactivo"}`)
          .join("\n");
        syncStockFromVariantRows(scope);
      };

      const renderVariantRows = (scope, variants = []) => {
        const list = document.querySelector(`[data-variant-list="${scope}"]`);
        const empty = document.querySelector(`[data-variant-empty="${scope}"]`);
        if (!isElement(list)) return;

        list.innerHTML = variants
          .map(
            (variant) => `
              <article class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-3 md:grid-cols-[minmax(0,1fr)_120px_150px_44px] md:items-end" data-variant-row data-variant-id="${escapeHtml(variant.id ?? "")}">
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Diseño</span>
                  <input data-variant-name type="text" value="${escapeHtml(variant.name ?? "")}" placeholder="Salamence" class="h-11 w-full rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Stock</span>
                  <input data-variant-stock type="number" min="0" step="1" value="${escapeHtml(Number(variant.stock ?? 0))}" class="h-11 w-full rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" />
                </label>
                <label class="block">
                  <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Estado</span>
                  <select data-variant-status class="h-11 w-full rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15">
                    <option value="active" ${variant.active === false ? "" : "selected"}>Activo</option>
                    <option value="inactive" ${variant.active === false ? "selected" : ""}>Inactivo</option>
                  </select>
                </label>
                <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 text-sm font-semibold text-slate-600 transition hover:border-red-300 hover:text-red-600" data-variant-remove aria-label="Quitar diseño">X</button>
              </article>
            `
          )
          .join("");

        if (isElement(empty)) empty.classList.toggle("hidden", variants.length > 0);
        syncVariantText(scope);
      };

      const addVariantRow = (scope) => {
        const variants = collectVariantRows(scope);
        renderVariantRows(scope, [...variants, { name: "", stock: 0, active: true }]);
      };

      const uniqueSorted = (values) =>
        Array.from(new Set(values.map((value) => String(value ?? "").trim()).filter(Boolean))).sort((a, b) =>
          a.localeCompare(b, "es")
        );

      const renderDatalist = (element, values) => {
        if (!(element instanceof HTMLDataListElement)) return;
        element.innerHTML = values.map((value) => `<option value="${escapeHtml(value)}"></option>`).join("");
      };

      const renderSelectOptions = (element, values, selectedValue = "") => {
        if (!(element instanceof HTMLSelectElement)) return;
        const options = selectedValue ? uniqueSorted([...values, selectedValue]) : uniqueSorted(values);
        element.innerHTML = options.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join("");
        if (selectedValue) element.value = selectedValue;
      };

      const getAllProductCategories = () =>
        uniqueSorted([
          ...inventoryItems.map((product) => product.category),
          ...catalogOptions.categories,
          ...Object.values(productCategoryOptions).flat()
        ]);

      const renderDynamicOptions = () => {
        const sets = uniqueSorted([
          ...inventoryItems.map((product) => product.set),
          ...catalogOptions.sets
        ]);
        const categories = getAllProductCategories();
        const illustrators = uniqueSorted([
          ...inventoryItems.map((product) => product.illustrator),
          ...catalogOptions.illustrators
        ]);

        renderDatalist(setOptions, sets);
        renderDatalist(categoryOptions, categories);
        renderDatalist(illustratorOptions, illustrators);
        renderSelectOptions(
          productEditInputs.find((input) => input instanceof HTMLElement && input.dataset.productEdit === "category"),
          categories,
          productEditInputs.find((input) => input instanceof HTMLSelectElement && input.dataset.productEdit === "category")?.value ?? ""
        );
        renderProductCreateCategories();

        const optionGroups = {
          sets: catalogOptions.sets,
          categories: catalogOptions.categories,
          illustrators: catalogOptions.illustrators
        };
        optionLists.forEach((list) => {
          if (!isElement(list)) return;
          const values = optionGroups[list.dataset.optionList] ?? [];
          list.innerHTML = values.length
            ? values
                .map(
                  (value) =>
                    `<button type="button" class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-red-50 hover:text-red-700" data-option-remove="${escapeHtml(list.dataset.optionList)}" data-option-value="${escapeHtml(value)}" title="Quitar ${escapeHtml(value)}">${escapeHtml(value)} X</button>`
                )
                .join("")
            : `<span class="text-sm text-slate-500">Sin opciones</span>`;
        });
      };

      const saveCatalogOptions = async () => {
        if (!catalogOptionsWritable) {
          throw new Error("Las listas del catalogo no estan disponibles en este API.");
        }
        const response = await fetch(`${API_BASE_URL}/api/admin/site-settings/catalog-options`, {
          method: "PATCH",
          headers: authHeaders(),
          body: JSON.stringify(catalogOptions)
        });
        const payload = await response.json().catch(() => null);
        if (response.status === 404) {
          catalogOptionsWritable = false;
          renderDynamicOptions();
          throw new Error("Las listas del catalogo no estan disponibles en este API.");
        }
        if (!response.ok) throw new Error(payload?.error ?? "No se pudieron guardar las listas.");
        catalogOptionsWritable = true;
        catalogOptions = {
          sets: Array.isArray(payload.data?.sets) ? payload.data.sets : [],
          categories: Array.isArray(payload.data?.categories) ? payload.data.categories : [],
          illustrators: Array.isArray(payload.data?.illustrators) ? payload.data.illustrators : []
        };
        renderDynamicOptions();
      };

      const loadCatalogOptions = async () => {
        try {
          const response = await fetch(`${API_BASE_URL}/api/site-settings/catalog-options`);
          const payload = await response.json().catch(() => null);
          if (response.status === 404) {
            catalogOptionsWritable = false;
            renderDynamicOptions();
            return;
          }
          if (!response.ok) throw new Error(payload?.error ?? "No se pudieron cargar las listas.");
          catalogOptionsWritable = true;
          catalogOptions = {
            sets: Array.isArray(payload.data?.sets) ? payload.data.sets : [],
            categories: Array.isArray(payload.data?.categories) ? payload.data.categories : [],
            illustrators: Array.isArray(payload.data?.illustrators) ? payload.data.illustrators : []
          };
          renderDynamicOptions();
        } catch (error) {
          showOptionsMessage(error instanceof Error ? error.message : "No se pudieron cargar las listas.");
        }
      };

      const addCatalogOption = async (group) => {
        const input = optionInputs.find((element) => element instanceof HTMLInputElement && element.dataset.optionInput === group);
        const value = input instanceof HTMLInputElement ? input.value.trim() : "";
        if (!value || !Array.isArray(catalogOptions[group])) return;
        catalogOptions[group] = uniqueSorted([...catalogOptions[group], value]);
        if (input instanceof HTMLInputElement) input.value = "";
        await saveCatalogOptions();
        showOptionsMessage("Lista actualizada.");
      };

      const removeCatalogOption = async (group, value) => {
        if (!Array.isArray(catalogOptions[group])) return;
        catalogOptions[group] = catalogOptions[group].filter((item) => item !== value);
        await saveCatalogOptions();
        showOptionsMessage("Opcion quitada.");
      };

      const renderProductCreateCategories = () => {
        if (!isSelect(productCreateKindInput) || !isSelect(productCreateCategoryInput)) return;

        const kind = productCreateKindInput.value === "single" ? "single" : "sealed";
        const categories = uniqueSorted([
          ...(Array.isArray(productCategoryOptions[kind]) ? productCategoryOptions[kind] : []),
          ...inventoryItems.filter((product) => product.kind === kind).map((product) => product.category),
          ...catalogOptions.categories
        ]);
        const previousValue = productCreateCategoryInput.value;

        renderSelectOptions(productCreateCategoryInput, categories, categories.includes(previousValue) ? previousValue : categories[0]);
      };

      const activeClass =
        "rounded-full bg-[color:var(--color-primary)] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#173b56]";
      const inactiveClass =
        "rounded-full border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900";

      const renderAdminTab = () => {
        adminTabs.forEach((tab) => {
          if (!(tab instanceof HTMLButtonElement)) return;
          const isActive = tab.dataset.adminTab === activeAdminTab;
          tab.className = isActive
            ? "rounded-[1rem] bg-white px-4 py-3 text-sm font-semibold text-slate-950 shadow-sm"
            : "rounded-[1rem] px-4 py-3 text-sm font-semibold text-slate-600 transition hover:text-slate-950";
          tab.setAttribute("aria-pressed", isActive ? "true" : "false");
        });

        adminPanels.forEach((panel) => {
          if (!isElement(panel)) return;
          panel.classList.toggle("hidden", panel.dataset.adminPanel !== activeAdminTab);
        });
      };

      const updateTypeButtons = () => {
        const sealedActiveCount = inventoryItems.filter(
          (product) => product.type === "sellado" && getProductState(product).status === "active"
        ).length;
        const singlesActiveCount = inventoryItems.filter(
          (product) => product.type === "single" && getProductState(product).status === "active"
        ).length;

        if (isElement(sealedCount)) sealedCount.textContent = String(sealedActiveCount);
        if (isElement(singlesCount)) singlesCount.textContent = String(singlesActiveCount);

        typeButtons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;

          const isActive = button.dataset.type === activeType;
          button.className = isActive ? activeClass : inactiveClass;
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      };

      const getFilteredProducts = () => {
        const query = isInput(searchInput) ? searchInput.value.trim().toLowerCase() : "";
        return inventoryItems.filter((product) => {
          const matchesType = product.type === activeType;
          const matchesQuery =
            query.length === 0 ||
            product.name.toLowerCase().includes(query) ||
            product.category.toLowerCase().includes(query) ||
            product.set.toLowerCase().includes(query);
          return matchesType && matchesQuery;
        });
      };

      const renderProductOptions = () => {
        if (!isSelect(productSelect)) return;

        const filteredProducts = getFilteredProducts();
        productSelect.innerHTML = filteredProducts
          .map((product) => {
            const productState = getProductState(product);
            const suffix = productState.status === "inactive" ? " (inactivo)" : "";
            return `<option value="${product.id}">${product.name}${suffix}</option>`;
          })
          .join("");

        productSelect.disabled = filteredProducts.length === 0;
        renderSelectedProduct();
      };

      const getSelectedProduct = () => {
        if (!isSelect(productSelect)) return null;
        return productMap.get(productSelect.value) ?? null;
      };

      const setProductEditField = (key, value) => {
        const field = productEditInputs.find((input) => input instanceof HTMLElement && input.dataset.productEdit === key);
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
          if (field instanceof HTMLSelectElement && key === "category" && value && !Array.from(field.options).some((option) => option.value === String(value))) {
            field.append(new Option(String(value), String(value)));
          }
          field.value = value == null ? "" : String(value);
        }
      };

      const renderSelectedProduct = () => {
        const product = getSelectedProduct();

        if (!product) {
          if (isElement(productType)) productType.textContent = activeType === "single" ? "Single" : "Sellado";
          if (isElement(productName)) productName.textContent = "Sin productos";
          if (isElement(productMeta)) productMeta.textContent = "Cambia el filtro o busca otro producto.";
          if (isInput(stockInput)) stockInput.value = "0";
          if (isSelect(statusSelect)) statusSelect.value = "active";
          productEditInputs.forEach((input) => {
            if (input instanceof HTMLInputElement || input instanceof HTMLSelectElement || input instanceof HTMLTextAreaElement) input.value = "";
          });
          renderVariantRows("edit", []);
          return;
        }

        const productState = getProductState(product);

        if (isElement(productType)) productType.textContent = product.typeLabel;
        if (isElement(productName)) productName.textContent = product.name;
        if (isElement(productMeta)) productMeta.textContent = `${product.category} - ${product.set}`;
        if (isInput(stockInput)) stockInput.value = String(productState.stock);
        if (isSelect(statusSelect)) statusSelect.value = productState.status;
        if (isElement(statusBadge)) {
          const isActive = productState.status === "active";
          statusBadge.textContent = `${isActive ? "Activo" : "Inactivo"} - Stock ${productState.stock}`;
          statusBadge.className = isActive
            ? "w-fit rounded-full bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700"
            : "w-fit rounded-full bg-red-50 px-4 py-2 text-sm font-semibold text-red-700";
        }

        setProductEditField("kind", product.kind);
        setProductEditField("name", product.name);
        setProductEditField("category", product.category);
        setProductEditField("description", product.description ?? "");
        setProductEditField("set", product.set);
        setProductEditField("language", product.language);
        setProductEditField("price", product.price);
        setProductEditField("image", product.image);
        setProductEditField("previousPrice", product.previousPrice ?? "");
        setProductEditField("offer", product.offer ?? "");
        setProductEditField("illustrator", product.illustrator ?? "");
        setProductEditField("rarity", product.rarity ?? "");
        setProductEditField("playability", product.playability ?? "");
        setProductEditField("marketPrice", product.marketPrice ?? "");
        setProductEditField("manualSegment", product.manualSegment ?? "");
        renderVariantRows("edit", product.variants);
      };

      const syncStatusWithStock = () => {
        if (!isInput(stockInput) || !isSelect(statusSelect)) return;

        const stock = Number(stockInput.value);
        if (Number.isFinite(stock) && stock <= 0) {
          stockInput.value = "0";
          statusSelect.value = "inactive";
        } else if (Number.isFinite(stock) && stock > 0) {
          statusSelect.value = "active";
        }
      };

      const persistSelectedProduct = async () => {
        const product = getSelectedProduct();
        if (!product || !isInput(stockInput) || !isSelect(statusSelect)) return;

        if (hasVariantRows("edit") || (Array.isArray(product.variants) && product.variants.length > 0)) {
          try {
            await saveProductDetails();
          } catch (error) {
            showMessage(error instanceof Error ? error.message : "No se pudieron guardar los diseños.");
            return;
          }
        }

        syncStatusWithStock();
        const stock = Number(stockInput.value);
        const latestProduct = productMap.get(product.id) ?? product;
        const nextState = {
          stock: Number.isFinite(stock) && stock >= 0 ? stock : 0,
          status: statusSelect.value === "inactive" ? "inactive" : "active",
          variants: Array.isArray(latestProduct.variants) ? latestProduct.variants : []
        };

        try {
          const updatedProduct = await updateInventory(latestProduct, nextState);
          const mappedProduct = mapProductForAdmin(updatedProduct);
          Object.assign(latestProduct, mappedProduct);
          productMap.set(mappedProduct.id, mappedProduct);
          state[mappedProduct.id] = {
            stock: nextState.stock,
            status: nextState.status,
            variants: mappedProduct.variants
          };
          saveState();
          showMessage("Producto actualizado en el backend.");
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "No se pudo actualizar el inventario.");
          return;
        }
        renderProductOptions();
        if (isSelect(productSelect)) productSelect.value = product.id;
        updateTypeButtons();
        renderSelectedProduct();
      };

      const readProductEditForm = () =>
        (syncVariantText("edit"), productEditInputs.reduce((input, element) => {
          if (!(element instanceof HTMLInputElement) && !(element instanceof HTMLSelectElement) && !(element instanceof HTMLTextAreaElement)) return input;
          const key = element.dataset.productEdit;
          if (!key) return input;
          input[key] = element.value.trim();
          return input;
        }, {}));

      const saveProductDetails = async () => {
        const product = getSelectedProduct();
        if (!product) return;

        const raw = readProductEditForm();
        const price = Number(raw.price ?? 0);
        const previousPrice =
          raw.previousPrice === "" || raw.previousPrice == null ? null : Number(raw.previousPrice);
        const marketPrice = raw.marketPrice === "" || raw.marketPrice == null ? null : Number(raw.marketPrice);
        if (!raw.name || !raw.category || !raw.set || !raw.image) {
          throw new Error("Completa nombre, categoria, set e imagen.");
        }
        if (!Number.isFinite(price) || price <= 0) throw new Error("El precio debe ser mayor a 0.");
        if (previousPrice !== null && !Number.isFinite(previousPrice)) {
          throw new Error("El precio anterior debe quedar vacio o ser un numero valido.");
        }
        if (marketPrice !== null && !Number.isFinite(marketPrice)) {
          throw new Error("El precio mercado debe quedar vacio o ser un numero valido.");
        }
        const variantRows = normalizeVariantRows("edit");
        const variants = variantRows.length > 0 ? variantRows : null;
        const variantStock = Array.isArray(variants)
          ? variants.reduce((total, variant) => total + (variant.active === false ? 0 : Number(variant.stock ?? 0)), 0)
          : null;
        const currentStock = Number(product.stock ?? 0);

        const updatedProduct = await updateProductDetails(product, {
          kind: raw.kind === "single" ? "single" : "sealed",
          name: raw.name,
          category: raw.category,
          description: raw.description || null,
          set: raw.set,
          language: raw.language,
          stock: variantStock ?? (Number.isFinite(currentStock) ? currentStock : 0),
          price,
          image: raw.image,
          previousPrice: previousPrice !== null && previousPrice > 0 ? previousPrice : null,
          offer: raw.offer || null,
          illustrator: raw.illustrator || null,
          rarity: raw.rarity || null,
          playability: raw.playability || null,
          marketPrice: marketPrice !== null && marketPrice > 0 ? marketPrice : null,
          manualSegment: raw.manualSegment || null,
          variants
        });
        const mappedProduct = mapProductForAdmin(updatedProduct);
        const index = inventoryItems.findIndex((item) => item.id === product.id);
        if (index >= 0) inventoryItems[index] = mappedProduct;
        productMap.set(mappedProduct.id, mappedProduct);
        state[mappedProduct.id] = {
          stock: mappedProduct.stock,
          status: mappedProduct.active === false ? "inactive" : "active",
          variants: mappedProduct.variants
        };
        saveState();
        activeType = mappedProduct.type;
        renderDynamicOptions();
        renderProductOptions();
        if (isSelect(productSelect)) productSelect.value = mappedProduct.id;
        updateTypeButtons();
        renderSelectedProduct();
        showProductEditMessage("Datos del producto actualizados.");
      };

      const readProductCreateForm = () =>
        (syncVariantText("create"), productCreateInputs.reduce((input, element) => {
          if (!(element instanceof HTMLInputElement) && !(element instanceof HTMLSelectElement) && !(element instanceof HTMLTextAreaElement)) return input;
          const key = element.dataset.productCreate;
          if (!key) return input;
          input[key] = element.value.trim();
          return input;
        }, {}));

      const createProduct = async () => {
        const raw = readProductCreateForm();
        const hasOffer = productCreateOfferToggle instanceof HTMLInputElement && productCreateOfferToggle.checked;
        const stock = Number(raw.stock ?? 0);
        const variantRows = normalizeVariantRows("create");
        const variants = variantRows.length > 0 ? variantRows : null;
        const price = Number(raw.price ?? 0);
        const previousPrice = Number(raw.previousPrice ?? 0);
        const requiredFields = ["name", "category", "set", "image"];
        const missingField = requiredFields.find((field) => !raw[field]);
        if (missingField) throw new Error("Completa nombre, categoria, set, imagen y valor ahora.");
        if (!Number.isFinite(price) || price <= 0) throw new Error("El valor ahora debe ser mayor a 0.");
        if (hasOffer && (!Number.isFinite(previousPrice) || previousPrice <= price)) {
          throw new Error("Para oferta, el valor anterior debe ser mayor al valor ahora.");
        }

        const response = await fetch(`${API_BASE_URL}/api/products`, {
          method: "POST",
          headers: authHeaders(),
          body: JSON.stringify({
            id: createProductId(raw.name),
            kind: raw.kind,
            name: raw.name,
            category: raw.category,
            description: raw.description || null,
            set: raw.set,
            language: raw.language,
            stock: variants ? variants.reduce((total, variant) => total + (variant.active === false ? 0 : variant.stock), 0) : Number.isFinite(stock) ? stock : 0,
            variants,
            price,
            previousPrice: hasOffer ? previousPrice : null,
            image: raw.image,
            offer: hasOffer ? raw.offer || "Oferta" : null,
            illustrator: raw.illustrator || null,
            active: true
          })
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) {
          if (response.status === 409) {
            const products = await loadInventoryProducts();
            const existingProduct = products.find(
              (product) => product.id === createProductId(raw.name) || product.name?.toLowerCase() === raw.name.toLowerCase()
            );
            if (existingProduct) {
              activeType = existingProduct.kind === "single" ? "single" : "sellado";
              renderProductOptions();
              if (isSelect(productSelect)) productSelect.value = existingProduct.id;
              updateTypeButtons();
              renderSelectedProduct();
              throw new Error("Ese producto ya existe. Lo cargue en el inventario para que puedas editarlo.");
            }
          }
          throw new Error(getProductCreateError(payload));
        }

        const adminProduct = mapProductForAdmin(payload.data);

        inventoryItems.unshift(adminProduct);
        productMap.set(adminProduct.id, adminProduct);
        if (productCreateForm instanceof HTMLFormElement) {
          productCreateForm.reset();
          renderProductCreateCategories();
          renderProductCreateOfferFields();
          renderVariantRows("create", []);
        }
        renderDynamicOptions();
        renderProductOptions();
        updateTypeButtons();
        showProductCreateMessage("Producto creado. Ya aparece en inventario.");
      };

      const getFilteredUsers = () => {
        const query = isInput(userFilter) ? userFilter.value.trim().toLowerCase() : "";
        const role = isSelect(userRoleFilter) ? userRoleFilter.value : "";
        return adminUsers.filter((user) => {
          const matchesQuery =
            !query ||
            String(user.username ?? "").toLowerCase().includes(query) ||
            String(user.role ?? "").toLowerCase().includes(query);
          const matchesRole = !role || user.role === role;
          return matchesQuery && matchesRole;
        });
      };

      const renderUsers = () => {
        if (!isElement(usersContainer)) return;
        const users = getFilteredUsers();
        usersContainer.innerHTML = users.length
          ? users
              .map(
                (user) => `
                  <article class="grid gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 lg:grid-cols-[1fr_180px_120px] lg:items-end">
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Usuario</span>
                      <input value="${escapeHtml(user.username)}" class="h-11 w-full rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition disabled:cursor-not-allowed disabled:opacity-70 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" data-user-name="${escapeHtml(user.id)}" ${usersReadOnly ? "disabled" : ""} />
                    </label>
                    <label class="block">
                      <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Rol</span>
                      <select class="h-11 w-full rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition disabled:cursor-not-allowed disabled:opacity-70 focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" data-user-role="${escapeHtml(user.id)}" ${usersReadOnly ? "disabled" : ""}>
                        <option value="customer" ${user.role === "customer" ? "selected" : ""}>Cliente</option>
                        <option value="admin" ${user.role === "admin" ? "selected" : ""}>Admin</option>
                      </select>
                    </label>
                    ${
                      usersReadOnly
                        ? `<span class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-500">Solo lectura</span>`
                        : `<button type="button" class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950" data-user-save="${escapeHtml(user.id)}">Guardar</button>`
                    }
                  </article>
                `
              )
              .join("")
          : `<p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center text-sm font-semibold text-slate-500">No hay usuarios para ese filtro.</p>`;
      };

      const loadUsers = async () => {
        try {
          usersReadOnly = false;
          const response = await fetch(`${API_BASE_URL}/api/admin/users`, {
            headers: authHeaders()
          });
          const payload = await response.json().catch(() => null);
          if (response.status === 404) {
            const session = readSession();
            if (!session?.token) throw new Error("Sesion admin requerida.");
            const meResponse = await fetch(`${API_BASE_URL}/api/auth/me`, {
              headers: {
                Authorization: `Bearer ${session.token}`
              }
            });
            const mePayload = await meResponse.json().catch(() => null);
            if (!meResponse.ok || !mePayload?.user) throw new Error("No se pudo cargar la sesion actual.");
            usersReadOnly = true;
            adminUsers = [mePayload.user];
            renderUsers();
            showUserMessage("Gestion completa de usuarios no disponible en este API.");
            return;
          }
          if (!response.ok) throw new Error(payload?.error ?? "No se pudieron cargar los usuarios.");
          adminUsers = Array.isArray(payload.data) ? payload.data : [];
          renderUsers();
        } catch (error) {
          if (isElement(usersContainer)) {
            usersContainer.innerHTML = `<p class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">${escapeHtml(error instanceof Error ? error.message : "No se pudieron cargar los usuarios.")}</p>`;
          }
        }
      };

      const updateUser = async (id, container = document) => {
        const usernameInput = container.querySelector(`[data-user-name="${id}"]`);
        const roleSelect = container.querySelector(`[data-user-role="${id}"]`);
        const username = usernameInput instanceof HTMLInputElement ? usernameInput.value.trim() : "";
        const role = roleSelect instanceof HTMLSelectElement && roleSelect.value === "admin" ? "admin" : "customer";
        if (!username) throw new Error("El usuario no puede quedar vacio.");

        const response = await fetch(`${API_BASE_URL}/api/admin/users/${id}`, {
          method: "PATCH",
          headers: authHeaders(),
          body: JSON.stringify({ username, role })
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error ?? "No se pudo actualizar el usuario.");

        adminUsers = adminUsers.map((user) => (user.id === id ? payload.data : user));
        renderUsers();
        showUserMessage("Usuario actualizado.");
      };

      const getFilteredOrders = () => {
        const userQuery = isInput(orderUserFilter) ? orderUserFilter.value.trim().toLowerCase() : "";
        const statusQuery = isSelect(orderStatusFilter) ? orderStatusFilter.value : "";

        return adminOrders.filter((order) => {
          const userText = [
            order.customer_name,
            order.customer_email,
            order.customer_phone,
            order.user_id
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();
          const matchesUser = !userQuery || userText.includes(userQuery);
          const matchesStatus = !statusQuery || order.status === statusQuery;
          return matchesUser && matchesStatus;
        });
      };

      const renderOrders = () => {
        const orders = getFilteredOrders();
        if (isElement(ordersEmpty)) ordersEmpty.classList.toggle("hidden", orders.length > 0);
        if (isElement(orderFilterSummary)) {
          orderFilterSummary.textContent = `${orders.length} de ${adminOrders.length} compra(s)`;
        }
        if (!isElement(ordersContainer)) return;

        ordersContainer.innerHTML = orders
          .map(
            (order) => `
              <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="grid gap-4 lg:grid-cols-[1fr_180px] lg:items-start">
                  <div>
                    <p class="text-sm font-semibold text-slate-950">${escapeHtml(order.id)}</p>
                    <p class="mt-1 text-xs text-slate-500">${escapeHtml(new Date(order.created_at ?? Date.now()).toLocaleString("es-CL"))}</p>
                    <p class="mt-3 text-sm font-semibold text-[color:var(--color-primary)]">${escapeHtml(order.customer_name)} · ${escapeHtml(order.customer_email)}</p>
                    <p class="mt-1 text-sm text-slate-600">${escapeHtml(order.delivery_mode)} · ${Number(order.items?.length ?? 0)} producto(s)</p>
                    <p class="mt-2 text-sm text-slate-600">Subtotal ${currencyFormatter.format(Number(order.subtotal ?? 0))} · Descuento ${currencyFormatter.format(Number(order.discount ?? 0))} · Total ${currencyFormatter.format(Number(order.total ?? 0))}</p>
                  </div>
                  <label class="block">
                    <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Estado</span>
                    <select class="h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" data-order-status="${escapeHtml(order.id)}">
                      ${Object.entries(statusLabels)
                        .map(([value, label]) => `<option value="${value}" ${order.status === value ? "selected" : ""}>${label}</option>`)
                        .join("")}
                    </select>
                  </label>
                </div>
              </article>
            `
          )
          .join("");
      };

      const loadOrders = async () => {
        try {
          const response = await fetch(`${API_BASE_URL}/api/orders`, {
            headers: authHeaders()
          });
          const payload = await response.json().catch(() => null);
          if (!response.ok) throw new Error(payload?.error ?? "No se pudieron cargar las compras.");
          adminOrders = Array.isArray(payload.data) ? payload.data : [];
          renderOrders();
        } catch (error) {
          if (isElement(ordersContainer)) {
            ordersContainer.innerHTML = `<p class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">${escapeHtml(error instanceof Error ? error.message : "No se pudieron cargar las compras.")}</p>`;
          }
        }
      };

      const updateOrderStatus = async (id, status) => {
        const response = await fetch(`${API_BASE_URL}/api/orders/${id}/status`, {
          method: "PATCH",
          headers: authHeaders(),
          body: JSON.stringify({ status })
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error ?? "No se pudo actualizar el estado.");
      };

      const renderDiscounts = (discounts) => {
        if (!isElement(discountsContainer)) return;

        discountsContainer.innerHTML = discounts
          .map(
            (discount) => `
              <article class="grid gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 lg:grid-cols-[1fr_150px_120px_120px] lg:items-center">
                <div>
                  <p class="text-base font-semibold text-[color:var(--color-primary)]">${escapeHtml(discount.code)}</p>
                  <p class="mt-1 text-sm text-slate-500">${discount.type === "percent" ? `${discount.value}%` : currencyFormatter.format(Number(discount.value))} · ${Number(discount.used_count ?? 0)} uso(s)${discount.max_uses ? ` de ${discount.max_uses}` : ""}</p>
                </div>
                <select class="h-11 rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" data-discount-active="${escapeHtml(discount.id)}">
                  <option value="true" ${discount.active ? "selected" : ""}>Activo</option>
                  <option value="false" ${!discount.active ? "selected" : ""}>Inactivo</option>
                </select>
                <input type="number" min="0" step="0.01" value="${escapeHtml(discount.value)}" class="h-11 rounded-2xl border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition focus:border-[color:var(--color-secondary)] focus:ring-4 focus:ring-[color:var(--color-secondary)]/15" data-discount-value="${escapeHtml(discount.id)}" />
                <button type="button" class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-950" data-discount-save="${escapeHtml(discount.id)}">
                  Guardar
                </button>
              </article>
            `
          )
          .join("");
      };

      const loadDiscounts = async () => {
        try {
          const response = await fetch(`${API_BASE_URL}/api/admin/discount-codes`, {
            headers: authHeaders()
          });
          const payload = await response.json().catch(() => null);
          if (!response.ok) throw new Error(payload?.error ?? "No se pudieron cargar los descuentos.");
          renderDiscounts(Array.isArray(payload.data) ? payload.data : []);
        } catch (error) {
          if (isElement(discountsContainer)) {
            discountsContainer.innerHTML = `<p class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">${escapeHtml(error instanceof Error ? error.message : "No se pudieron cargar los descuentos.")}</p>`;
          }
        }
      };

      const fillHeroForm = (settings) => {
        heroSettings = settings;
        heroInputs.forEach((input) => {
          if (!(input instanceof HTMLInputElement) && !(input instanceof HTMLTextAreaElement)) return;
          const key = input.dataset.heroInput;
          input.value = key ? String(settings?.[key] ?? "") : "";
        });

        if (heroPreview instanceof HTMLImageElement) {
          heroPreview.src = settings?.backgroundImageUrl || "/sets/logo.webp";
        }
      };

      const readHeroForm = () =>
        heroInputs.reduce((input, element) => {
          if (!(element instanceof HTMLInputElement) && !(element instanceof HTMLTextAreaElement)) return input;
          const key = element.dataset.heroInput;
          if (!key) return input;
          input[key] = element.value.trim();
          return input;
        }, {});

      const loadHeroSettings = async () => {
        try {
          const response = await fetch(`${API_BASE_URL}/api/site-settings/hero`);
          const payload = await response.json().catch(() => null);
          if (!response.ok) throw new Error(payload?.error ?? "No se pudo cargar el hero.");
          fillHeroForm(payload.data ?? {});
        } catch (error) {
          showHeroMessage(error instanceof Error ? error.message : "No se pudo cargar el hero.");
        }
      };

      const saveHeroSettings = async () => {
        const response = await fetch(`${API_BASE_URL}/api/admin/site-settings/hero`, {
          method: "PATCH",
          headers: authHeaders(),
          body: JSON.stringify(readHeroForm())
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error ?? "No se pudo guardar el hero.");

        fillHeroForm(payload.data ?? heroSettings);
        showHeroMessage("Hero actualizado.");
      };

      const createDiscount = async () => {
        if (!isInput(discountCodeInput) || !isSelect(discountTypeInput) || !isInput(discountValueInput)) return;

        const value = Number(discountValueInput.value);
        const maxUses = isInput(discountMaxInput) ? Number(discountMaxInput.value) : 0;
        const response = await fetch(`${API_BASE_URL}/api/admin/discount-codes`, {
          method: "POST",
          headers: authHeaders(),
          body: JSON.stringify({
            code: discountCodeInput.value.trim(),
            type: discountTypeInput.value,
            value,
            active: true,
            maxUses: Number.isFinite(maxUses) && maxUses > 0 ? maxUses : null
          })
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error ?? "No se pudo crear el descuento.");

        discountCodeInput.value = "";
        discountValueInput.value = "";
        if (isInput(discountMaxInput)) discountMaxInput.value = "";
        showDiscountMessage("Codigo creado.");
        await loadDiscounts();
      };

      const updateDiscount = async (id, container = document) => {
        const activeSelect = container.querySelector(`[data-discount-active="${id}"]`);
        const valueInput = container.querySelector(`[data-discount-value="${id}"]`);
        const value = valueInput instanceof HTMLInputElement ? Number(valueInput.value) : 0;
        const active = activeSelect instanceof HTMLSelectElement ? activeSelect.value === "true" : true;
        const response = await fetch(`${API_BASE_URL}/api/admin/discount-codes/${id}`, {
          method: "PATCH",
          headers: authHeaders(),
          body: JSON.stringify({ active, value })
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error ?? "No se pudo actualizar el descuento.");

        showDiscountMessage("Codigo actualizado.");
        await loadDiscounts();
      };

      typeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (!(button instanceof HTMLButtonElement)) return;
          activeType = button.dataset.type === "single" ? "single" : "sellado";
          updateTypeButtons();
          renderProductOptions();
        });
      });

      searchInput?.addEventListener("input", renderProductOptions);
      productSelect?.addEventListener("change", renderSelectedProduct);
      statusSelect?.addEventListener("change", renderSelectedProduct);
      stockInput?.addEventListener("input", () => {
        syncStatusWithStock();
      });

      minusButton?.addEventListener("click", () => {
        if (!isInput(stockInput)) return;
        stockInput.value = String(Math.max(0, Number(stockInput.value) - 1));
        syncStatusWithStock();
      });

      plusButton?.addEventListener("click", () => {
        if (!isInput(stockInput)) return;
        stockInput.value = String(Number(stockInput.value) + 1);
        syncStatusWithStock();
      });

      toggleButton?.addEventListener("click", () => {
        if (!isSelect(statusSelect)) return;
        statusSelect.value = statusSelect.value === "active" ? "inactive" : "active";
        renderSelectedProduct();
      });

      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        persistSelectedProduct();
      });

      productEditForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          await saveProductDetails();
        } catch (error) {
          showProductEditMessage(error instanceof Error ? error.message : "No se pudo guardar el producto.");
        }
      });

      document.addEventListener("click", (event) => {
        const target = event.target instanceof HTMLElement ? event.target : null;
        const addButton = target?.closest("[data-variant-add]");
        if (addButton instanceof HTMLElement && addButton.dataset.variantAdd) {
          addVariantRow(addButton.dataset.variantAdd);
          return;
        }

        const removeButton = target?.closest("[data-variant-remove]");
        if (!(removeButton instanceof HTMLElement)) return;
        const builder = removeButton.closest("[data-variant-builder]");
        const scope = builder instanceof HTMLElement ? builder.dataset.variantBuilder : "";
        removeButton.closest("[data-variant-row]")?.remove();
        if (scope === "create" || scope === "edit") {
          syncVariantText(scope);
          const empty = document.querySelector(`[data-variant-empty="${scope}"]`);
          const hasRows = Boolean(document.querySelector(`[data-variant-builder="${scope}"] [data-variant-row]`));
          if (isElement(empty)) empty.classList.toggle("hidden", hasRows);
        }
      }, { signal: adminRuntimeSignal });

      document.addEventListener("input", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement) || !target.closest("[data-variant-row]")) return;
        const builder = target.closest("[data-variant-builder]");
        const scope = builder instanceof HTMLElement ? builder.dataset.variantBuilder : "";
        if (scope === "create" || scope === "edit") syncVariantText(scope);
      }, { signal: adminRuntimeSignal });

      document.addEventListener("change", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement) || !target.closest("[data-variant-row]")) return;
        const builder = target.closest("[data-variant-builder]");
        const scope = builder instanceof HTMLElement ? builder.dataset.variantBuilder : "";
        if (scope === "create" || scope === "edit") syncVariantText(scope);
      }, { signal: adminRuntimeSignal });

      productCreateOfferToggle?.addEventListener("change", renderProductCreateOfferFields);
      productCreateKindInput?.addEventListener("change", renderProductCreateCategories);

      productCreateForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          await createProduct();
        } catch (error) {
          showProductCreateMessage(error instanceof Error ? error.message : "No se pudo crear el producto.");
        }
      });

      document.addEventListener("click", async (event) => {
        const target = event.target instanceof HTMLElement ? event.target : null;
        const addButton = target?.closest("[data-option-add]");
        if (addButton instanceof HTMLElement && addButton.dataset.optionAdd) {
          try {
            await addCatalogOption(addButton.dataset.optionAdd);
          } catch (error) {
            showOptionsMessage(error instanceof Error ? error.message : "No se pudo agregar la opcion.");
          }
          return;
        }

        const removeButton = target?.closest("[data-option-remove]");
        if (removeButton instanceof HTMLElement && removeButton.dataset.optionRemove && removeButton.dataset.optionValue) {
          try {
            await removeCatalogOption(removeButton.dataset.optionRemove, removeButton.dataset.optionValue);
          } catch (error) {
            showOptionsMessage(error instanceof Error ? error.message : "No se pudo quitar la opcion.");
          }
        }
      }, { signal: adminRuntimeSignal });

      optionInputs.forEach((input) => {
        input.addEventListener("keydown", async (event) => {
          if (!(input instanceof HTMLInputElement) || event.key !== "Enter") return;
          event.preventDefault();
          const group = input.dataset.optionInput;
          if (!group) return;
          try {
            await addCatalogOption(group);
          } catch (error) {
            showOptionsMessage(error instanceof Error ? error.message : "No se pudo agregar la opcion.");
          }
        });
      });

      adminTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          if (!(tab instanceof HTMLButtonElement)) return;
          activeAdminTab = tab.dataset.adminTab ?? "inventory";
          renderAdminTab();
        });
      });

      orderUserFilter?.addEventListener("input", renderOrders);
      orderStatusFilter?.addEventListener("change", renderOrders);
      userFilter?.addEventListener("input", renderUsers);
      userRoleFilter?.addEventListener("change", renderUsers);
      refreshUsersButton?.addEventListener("click", loadUsers);

      usersContainer?.addEventListener("click", async (event) => {
        const target = event.target instanceof HTMLElement ? event.target.closest("[data-user-save]") : null;
        if (!(target instanceof HTMLElement) || !target.dataset.userSave) return;

        try {
          await updateUser(target.dataset.userSave, target.closest("article") ?? document);
        } catch (error) {
          showUserMessage(error instanceof Error ? error.message : "No se pudo actualizar el usuario.");
        }
      });

      ordersContainer?.addEventListener("change", async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLSelectElement) || !target.dataset.orderStatus) return;

        try {
          await updateOrderStatus(target.dataset.orderStatus, target.value);
          showMessage("Estado de compra actualizado.");
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "No se pudo actualizar el estado.");
          loadOrders();
        }
      });

      refreshOrdersButton?.addEventListener("click", loadOrders);

      discountForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          await createDiscount();
        } catch (error) {
          showDiscountMessage(error instanceof Error ? error.message : "No se pudo crear el descuento.");
        }
      });

      discountsContainer?.addEventListener("click", async (event) => {
        const target = event.target instanceof HTMLElement ? event.target.closest("[data-discount-save]") : null;
        if (!(target instanceof HTMLElement) || !target.dataset.discountSave) return;

        try {
          await updateDiscount(target.dataset.discountSave, target.closest("article") ?? document);
        } catch (error) {
          showDiscountMessage(error instanceof Error ? error.message : "No se pudo actualizar el descuento.");
        }
      });

      heroInputs.forEach((input) => {
        input.addEventListener("input", () => {
          if (!(input instanceof HTMLInputElement) || input.dataset.heroInput !== "backgroundImageUrl") return;
          if (heroPreview instanceof HTMLImageElement) {
            heroPreview.src = input.value.trim() || "/sets/logo.webp";
          }
        });
      });

      heroForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        try {
          await saveHeroSettings();
        } catch (error) {
          showHeroMessage(error instanceof Error ? error.message : "No se pudo guardar el hero.");
        }
      });

      adminLoginForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const user = isInput(adminUser) ? adminUser.value.trim() : "";
        const password = isInput(adminPassword) ? adminPassword.value : "";

        try {
          const session = await loginAdmin(user, password);
          createAdminSession(session);
          window.dispatchEvent(new CustomEvent("onlycartitas:auth-updated"));
          adminLoginError?.classList.add("hidden");
          if (isInput(adminUser)) adminUser.value = "";
          if (isInput(adminPassword)) adminPassword.value = "";
          renderAdminSession();
        } catch (error) {
          if (isElement(adminLoginError)) {
            adminLoginError.textContent = error instanceof Error ? error.message : "Usuario o clave incorrectos.";
            adminLoginError.classList.remove("hidden");
          }
        }
      });

      adminLogout?.addEventListener("click", () => {
        window.localStorage.removeItem(SESSION_KEY);
        window.dispatchEvent(new CustomEvent("onlycartitas:auth-updated"));
        renderAdminSession();
      });

      updateTypeButtons();
      renderDynamicOptions();
      renderProductOptions();
      renderProductCreateCategories();
      renderProductCreateOfferFields();
      renderVariantRows("create", []);
      renderVariantRows("edit", []);
      renderAdminTab();
      renderAdminSession();
      })();
    </script>
  </body>
</html>
