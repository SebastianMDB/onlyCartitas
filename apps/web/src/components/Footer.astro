---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/70 bg-[color:var(--color-surface)]/80">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-4 py-7 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <a href="/" class="flex w-fit items-center gap-3">
        <img
          src="/sets/logo.webp"
          alt="OnlyCartitas"
          width="48"
          height="48"
          class="h-10 w-10 shrink-0 rounded-2xl object-cover"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[color:var(--color-primary)]">
            OnlyCartitas
          </p>
          <p class="text-sm text-slate-500">TCG Store</p>
        </div>
      </a>

      <div class="flex flex-col gap-3 text-sm text-slate-500 sm:flex-row sm:items-center sm:gap-5">
        <a href="https://instagram.com/onlycartitas" target="_blank" rel="noreferrer" class="font-semibold hover:text-slate-950">
          Instagram
        </a>
        <a href="mailto:contacto@onlycartitas.cl" class="font-semibold hover:text-slate-950">
          contacto@onlycartitas.cl
        </a>
        <a href="/politicas" class="hover:text-slate-950">Politicas</a>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-slate-200 pt-5 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} OnlyCartitas. Todos los derechos reservados.</p>
      <p>Pedidos y consultas por Instagram o correo.</p>
    </div>
  </div>
</footer>
