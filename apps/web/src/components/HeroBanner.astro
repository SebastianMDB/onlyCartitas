---
import type { HeroSettings, Product } from "../lib/catalog";

type Props = {
  products: Product[];
  settings?: HeroSettings | null;
};

const { settings } = Astro.props;
const defaultHero: HeroSettings = {
  primaryBadge: "Set destacado",
  secondaryBadge: "Catalogo",
  title: "Productos disponibles",
  description: "Disponible en OnlyCartitas.",
  launchSetName: "Journey Together",
  launchTitle: "Catalogo OnlyCartitas",
  launchLabel: "Nuevo",
  primaryCtaLabel: "Ver lanzamiento",
  primaryCtaHref: "/sellados",
  secondaryCtaLabel: "Ver ofertas",
  secondaryCtaHref: "/ofertas",
  backgroundImageUrl: ""
};
const hero = { ...defaultHero, ...(settings ?? {}) };
const launchSetName = hero.launchSetName || defaultHero.launchSetName;
const apiBaseUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
---

<section class="mx-auto w-full max-w-7xl px-3 pt-5 sm:px-6 sm:pt-6 lg:px-8">
  <div class="relative overflow-hidden rounded-[1.5rem] bg-[color:var(--color-primary)] text-white shadow-[0_28px_80px_rgba(17,48,71,0.24)] sm:rounded-[2rem]" data-hero-root>
    <img
      src={hero.backgroundImageUrl}
      alt=""
      class={`absolute -inset-px h-[calc(100%+2px)] w-[calc(100%+2px)] object-cover opacity-95 ${hero.backgroundImageUrl ? "" : "hidden"}`}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      data-hero-background
    />
    <svg class={`absolute -inset-px h-[calc(100%+2px)] w-[calc(100%+2px)] object-cover opacity-95 ${hero.backgroundImageUrl ? "hidden" : ""}`} viewBox="0 0 1200 520" aria-hidden="true" preserveAspectRatio="xMidYMid slice" data-hero-fallback>
      <defs>
        <radialGradient id="launchGlowA" cx="70%" cy="45%" r="42%">
          <stop offset="0" stop-color="#8bd7ff" stop-opacity=".95" />
          <stop offset=".38" stop-color="#347fa8" stop-opacity=".55" />
          <stop offset="1" stop-color="#04131d" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="launchGlowB" cx="88%" cy="20%" r="34%">
          <stop offset="0" stop-color="#ffe17a" stop-opacity=".95" />
          <stop offset=".34" stop-color="#ff8d35" stop-opacity=".5" />
          <stop offset="1" stop-color="#04131d" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="launchTitleFill" x1="0" x2="1">
          <stop offset="0" stop-color="#f6fbff" />
          <stop offset=".45" stop-color="#aee7ff" />
          <stop offset="1" stop-color="#fff3a6" />
        </linearGradient>
        <pattern id="launchDots" width="32" height="32" patternUnits="userSpaceOnUse">
          <circle cx="4" cy="4" r="2" fill="#8bd7ff" opacity=".35" />
        </pattern>
        <filter id="launchShadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="12" stdDeviation="10" flood-color="#000" flood-opacity=".35" />
        </filter>
      </defs>
      <rect width="1200" height="520" fill="#04131d" />
      <rect width="1200" height="520" fill="url(#launchDots)" opacity=".55" />
      <rect width="1200" height="520" fill="url(#launchGlowA)" />
      <rect width="1200" height="520" fill="url(#launchGlowB)" />
      <g opacity=".9">
        <path d="M735 444c150-52 258-156 319-312" fill="none" stroke="#f7d655" stroke-width="24" stroke-linecap="round" opacity=".32" />
        <path d="M690 418c128-36 231-119 310-250" fill="none" stroke="#9ff0ff" stroke-width="14" stroke-linecap="round" opacity=".34" />
        <path d="M804 100c74 78 92 182 39 315" fill="none" stroke="#ec71ff" stroke-width="18" stroke-linecap="round" opacity=".32" />
      </g>
      <g transform="translate(720 72)" filter="url(#launchShadow)">
        <circle cx="128" cy="150" r="112" fill="#123d5a" opacity=".94" />
        <circle cx="128" cy="150" r="84" fill="#ffe17a" opacity=".92" />
        <path d="M66 162c38-82 92-112 160-104-24 34-44 66-60 98 33 1 62 12 88 32-74 11-126 49-156 115 2-48 12-86 31-116-25-6-46-15-63-25Z" fill="#ff7b35" />
        <path d="M35 229c66-28 117-26 154 6-46 5-90 21-133 48-8-16-15-34-21-54Z" fill="#8bd7ff" />
        <path d="M230 76c49 31 80 72 93 125-46-28-92-45-139-49 10-27 25-52 46-76Z" fill="#f6fbff" />
      </g>
      <g transform="translate(72 112)" filter="url(#launchShadow)">
        <text x="0" y="0" font-family="Baloo 2, Nunito Sans, Arial, sans-serif" font-size="34" font-weight="800" letter-spacing="2" fill="#f6fbff">POKEMON TCG</text>
        <rect x="0" y="22" width="168" height="34" rx="8" fill="#e53935" />
        <text x="84" y="45" text-anchor="middle" font-family="Nunito Sans, Arial, sans-serif" font-size="16" font-weight="800" fill="#fff">LANZAMIENTO</text>
        <text x="0" y="138" font-family="Baloo 2, Nunito Sans, Arial, sans-serif" font-size="78" font-weight="900" letter-spacing="1" fill="url(#launchTitleFill)">JOURNEY</text>
        <text x="0" y="220" font-family="Baloo 2, Nunito Sans, Arial, sans-serif" font-size="78" font-weight="900" letter-spacing="1" fill="url(#launchTitleFill)">TOGETHER</text>
        <text x="4" y="270" font-family="Nunito Sans, Arial, sans-serif" font-size="24" font-weight="700" letter-spacing="6" fill="#aee7ff">TRAINERS & PARTNERS</text>
      </g>
    </svg>
    <div class="absolute -inset-px bg-gradient-to-r from-[#04131d]/95 via-[#071c2b]/72 to-[#04131d]/12"></div>

    <div class="absolute left-5 right-5 top-5 z-10 sm:left-8 sm:right-auto sm:top-7 lg:left-10">
      <span class="inline-flex max-w-full items-center rounded-lg border border-white/55 bg-[#071824]/58 px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-white shadow-[0_14px_30px_rgba(4,19,29,0.28)] backdrop-blur-md sm:px-5 sm:py-2.5 sm:text-sm sm:tracking-[0.16em]">
        ENVIO GRATIS EN ANTOFAGASTA POR COMPRAS +90.000
      </span>
    </div>

    <div class="relative flex min-h-[440px] px-5 py-7 sm:min-h-[500px] sm:px-8 lg:px-10 lg:py-10">
      <div class="flex max-w-3xl flex-col justify-center gap-7 sm:gap-8">
        <div>
          <div class="hidden">
            <span class="inline-flex w-full items-center justify-center rounded-lg border-2 border-white/75 bg-[#04131d]/38 px-4 py-2 text-center text-sm font-black uppercase tracking-[0.08em] text-white shadow-[0_16px_36px_rgba(4,19,29,0.34)] backdrop-blur-sm sm:px-5 sm:py-2.5 sm:text-base sm:tracking-[0.12em]">
              Envío GRATIS en ANTOFAGASTA por compras +90.000
            </span>
          </div>

          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300 sm:text-sm sm:tracking-[0.24em]" data-hero-primary-badge>{hero.primaryBadge}</p>
            <h1 class="mt-3 text-4xl font-semibold leading-[0.94] tracking-tight sm:text-6xl lg:text-7xl" data-hero-launch-set>
              {launchSetName}
            </h1>
            <p class="mt-4 text-xl font-semibold leading-tight text-slate-100 sm:text-3xl" data-hero-title>{hero.title}</p>
          </div>
        </div>

        <div class="flex flex-col gap-4 sm:gap-5">
          <div class="flex flex-col gap-2.5 sm:flex-row sm:gap-3">
            <a
              href={hero.primaryCtaHref}
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-[#dcecf7] px-6 py-3 text-sm font-semibold text-[#061d2a] shadow-[0_14px_30px_rgba(17,48,71,0.24)] transition hover:bg-[#f4f9fc] sm:min-h-13 sm:px-7 sm:py-3.5 sm:text-base"
              data-hero-primary-cta
            >
              {hero.primaryCtaLabel}
            </a>
            <a
              href={hero.secondaryCtaHref}
              class="inline-flex min-h-10 items-center justify-center rounded-full border border-white/25 bg-[#071c2b]/55 px-6 py-2.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:border-white/40 hover:bg-[#123d5a]/70 sm:min-h-12 sm:py-3"
              data-hero-secondary-cta
            >
              {hero.secondaryCtaLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline type="application/json" data-hero-config set:html={JSON.stringify({ apiBaseUrl })}></script>
  <script>
    type HeroSettingsPayload = {
      primaryBadge?: string;
      title?: string;
      launchSetName?: string;
      primaryCtaLabel?: string;
      primaryCtaHref?: string;
      secondaryCtaLabel?: string;
      secondaryCtaHref?: string;
      backgroundImageUrl?: string;
    };

    const heroRuntimeKey = "__onlycartitasHeroRuntime";
    const heroCacheKey = "onlycartitas-hero-settings";
    const previousHeroRuntime = (window as Window & { __onlycartitasHeroRuntime?: AbortController })[heroRuntimeKey];
    previousHeroRuntime?.abort();
    const heroRuntime = new AbortController();
    (window as Window & { __onlycartitasHeroRuntime?: AbortController })[heroRuntimeKey] = heroRuntime;

    const readHeroConfig = () => {
      const configElement = document.querySelector("[data-hero-config]");
      try {
        return configElement?.textContent ? JSON.parse(configElement.textContent) : {};
      } catch {
        return {};
      }
    };

    const setText = (selector: string, value?: string) => {
      const element = document.querySelector(selector);
      if (element instanceof HTMLElement && value) element.textContent = value;
    };

    const setLink = (selector: string, label?: string, href?: string) => {
      const element = document.querySelector(selector);
      if (!(element instanceof HTMLAnchorElement)) return;
      if (label) element.textContent = label;
      if (href) element.href = href;
    };

    const toAbsoluteUrl = (value: string) => {
      try {
        return new URL(value, window.location.origin).href;
      } catch {
        return value;
      }
    };

    const readCachedHeroSettings = (): HeroSettingsPayload | null => {
      try {
        const value = window.localStorage.getItem(heroCacheKey);
        return value ? JSON.parse(value) : null;
      } catch {
        return null;
      }
    };

    const writeCachedHeroSettings = (settings: HeroSettingsPayload) => {
      try {
        window.localStorage.setItem(heroCacheKey, JSON.stringify(settings));
      } catch {
        // Cache is optional; the API response is still the source of truth.
      }
    };

    const waitForImage = async (image: HTMLImageElement, imageUrl: string, signal: AbortSignal) => {
      const absoluteUrl = toAbsoluteUrl(imageUrl);
      if (image.src !== absoluteUrl) image.src = imageUrl;
      if (image.complete && image.naturalWidth > 0) return true;

      try {
        await image.decode();
      } catch {
        await new Promise<void>((resolve) => {
          const finish = () => {
            signal.removeEventListener("abort", finish);
            image.removeEventListener("load", finish);
            image.removeEventListener("error", finish);
            resolve();
          };
          signal.addEventListener("abort", finish, { once: true });
          image.addEventListener("load", finish, { once: true, signal });
          image.addEventListener("error", finish, { once: true, signal });
        });
      }

      return !signal.aborted && image.complete && image.naturalWidth > 0;
    };

    const applyHeroSettings = async (settings: HeroSettingsPayload, signal: AbortSignal) => {
      if (signal.aborted) return;
      setText("[data-hero-primary-badge]", settings.primaryBadge);
      setText("[data-hero-launch-set]", settings.launchSetName);
      setText("[data-hero-title]", settings.title);
      setLink("[data-hero-primary-cta]", settings.primaryCtaLabel, settings.primaryCtaHref);
      setLink("[data-hero-secondary-cta]", settings.secondaryCtaLabel, settings.secondaryCtaHref);

      const background = document.querySelector("[data-hero-background]");
      const fallback = document.querySelector("[data-hero-fallback]");
      const imageUrl = settings.backgroundImageUrl?.trim();
      if (background instanceof HTMLImageElement && fallback instanceof SVGElement) {
        if (!imageUrl) {
          background.classList.add("hidden");
          fallback.classList.remove("hidden");
          return;
        }

        const imageLoaded = await waitForImage(background, imageUrl, signal);
        if (signal.aborted) return;
        background.classList.toggle("hidden", !imageLoaded);
        fallback.classList.toggle("hidden", imageLoaded);
      }
    };

    const cachedSettings = readCachedHeroSettings();
    if (cachedSettings) void applyHeroSettings(cachedSettings, heroRuntime.signal);

    let hasRequestedHeroSettings = false;
    const refreshHeroSettings = async () => {
      if (hasRequestedHeroSettings || heroRuntime.signal.aborted) return;
      hasRequestedHeroSettings = true;
      const { apiBaseUrl } = readHeroConfig();
      if (!apiBaseUrl) return;

      try {
        const response = await fetch(`${apiBaseUrl}/api/site-settings/hero`, { cache: "no-store", signal: heroRuntime.signal });
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload?.data) return;
        writeCachedHeroSettings(payload.data);
        await applyHeroSettings(payload.data, heroRuntime.signal);
      } catch {
        // Keep the static hero usable if the API is unavailable.
      }
    };

    document.addEventListener("astro:page-load", refreshHeroSettings, { signal: heroRuntime.signal, once: true });
    if (document.readyState !== "loading") void refreshHeroSettings();
  </script>
</section>
